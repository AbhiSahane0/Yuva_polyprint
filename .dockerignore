# Everything the image builds from scratch, or must never be baked into it.
# Without this file `COPY apps/api apps/api` would copy the host's node_modules
# — the wrong platform's binaries, and hundreds of megabytes of them.

node_modules
**/node_modules

# Generated by the build inside the image
dist
**/dist
**/src/generated
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets. .env.neon holds live Neon credentials.
.env
.env.*
!.env.example
!**/.env.example

# Local-only
.git
.github
.vscode
.idea
docker-compose*.yml
**/coverage
**/.turbo
**/*.log
**/.DS_Store

# Frontend — not part of the API image
apps/web

# Docs and reference material
docs
*.md
!apps/api/README.md
