# ---------------------------------------------------------------------------
# Yuva Polyprint ERP — API environment
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Postgres. Matches the credentials in the repo-root docker-compose.yml.
DATABASE_URL="postgresql://yuva:yuva@localhost:5432/yuva_polyprint?schema=public"

# --- Neon (or any hosted Postgres) -----------------------------------------
# Point DATABASE_URL at the POOLED endpoint (host contains "-pooler") and
# DIRECT_URL at the direct one. The app uses the pooler; migrations need the
# direct connection, because a pooled endpoint cannot hold the locks DDL needs.
# Both must end with ?sslmode=require.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth is not built yet. It will be a plain username + password login with a
# server-side session — no JWT, no OAuth, no OTP.

# Comma-separated list of allowed browser origins.
#
# NOT NEEDED if the frontend proxies /api through its own domain, which is how
# vercel.json is set up: the browser only ever talks to the Vercel host, so no
# cross-origin request is made and this stays at the localhost default. That
# also means every Vercel preview deployment works with no configuration.
#
# Only relevant if the browser calls this API directly. Entries may contain `*`,
# which matches within a single hostname label — one pattern then covers every
# Vercel preview URL:
#
#   CORS_ORIGINS="https://yuva-polyprint.vercel.app,https://yuva-polyprint-*.vercel.app"
#
# Keep the project name in the pattern. "https://*.vercel.app" would let any
# site anyone deploys on Vercel call this API with credentials attached.
CORS_ORIGINS="http://localhost:5173"

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Rate limiting (applies to /api/*)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Email (Resend) — used to send a quotation to the customer.
#
# Optional. Without RESEND_API_KEY everything else works and only the send
# action reports that email is unavailable.
#
# MAIL_FROM must be an address Resend will send from:
#   onboarding@resend.dev  needs no domain, but Resend will ONLY deliver to the
#                          address that owns the Resend account. Fine for
#                          testing, useless for sending to a real customer.
#   you@yourdomain.com     anything else must be on a domain verified in the
#                          Resend dashboard. This is what real sending needs.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Yuva Polyprint <onboarding@resend.dev>"
# MAIL_REPLY_TO="office@yuvapolyprint.com"

# GSTIN lookup (gstinapi.in). Optional: without a key the offline format and
# check-digit validation still runs — only the "Verify" button is unavailable.
GSTIN_API_KEY=
GSTIN_API_BASE_URL=https://api.gstinapi.in
