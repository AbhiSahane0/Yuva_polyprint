# ---------------------------------------------------------------------------
# Yuva Polyprint ERP — API environment
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Postgres. Matches the credentials in the repo-root docker-compose.yml.
DATABASE_URL="postgresql://yuva:yuva@localhost:5432/yuva_polyprint?schema=public"

# Auth is not built yet. It will be a plain username + password login with a
# server-side session — no JWT, no OAuth, no OTP.

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173"

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Rate limiting (applies to /api/*)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
