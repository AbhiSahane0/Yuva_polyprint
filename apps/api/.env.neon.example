# ---------------------------------------------------------------------------
# Neon connection — used for deploying the schema and copying data up.
#
# Copy this file to `.env.neon` and paste your two connection strings in.
# `.env.neon` is git-ignored; this example is committed.
#
# Both come from the Neon console -> your project -> Connect:
#
#   DATABASE_URL  the POOLED endpoint. Its host contains "-pooler".
#                 This is what a deployed app should use.
#
#   DIRECT_URL    the direct endpoint, same host WITHOUT "-pooler".
#                 Migrations need this: a pooled endpoint cannot hold the
#                 advisory locks and DDL that `prisma migrate` requires.
#
# Keep ?sslmode=require on both — Neon refuses unencrypted connections.
#
# Local development is unaffected: apps/api/.env keeps pointing at Docker.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
