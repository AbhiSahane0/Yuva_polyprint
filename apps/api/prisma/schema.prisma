// Yuva Polyprint ERP — database schema
//
// Conventions:
//   - Model names PascalCase singular; tables snake_case plural via @@map
//   - Columns snake_case via @map
//   - Every table: id (cuid), createdAt, updatedAt
//   - Money and material quantities use Decimal, never Float
//   - Enums for status vocabularies rather than free-text strings
//
// The datasource URL is supplied by prisma.config.ts from DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What the customer physically receives.
enum JobKind {
  /// Printed film on the reel.
  ROLL
  /// Film converted into a bag.
  POUCH
}

/// Pouch styles the works produces. OTHER carries a free-text note alongside,
/// because a fixed list that cannot describe a real order is worse than none.
enum PouchType {
  STANDUP
  STANDUP_ZIPPER
  ZIPPER
  SPOUT
  CENTRE_SEAL
  THREE_SIDE_SEAL
  OTHER
}

/// How a customer record came into existence.
enum CustomerSource {
  /// Company details were written in the sheet's combined customer column.
  SHEET
  /// Provisional: created from a brand name recurring in job names, because
  /// the sheet never recorded the company. Contact details are 'NA'.
  BRAND_INFERRED
}

/// How a job's customer was determined.
enum JobCustomerSource {
  /// Named on the job's own row.
  EXPLICIT
  /// Matched through the brand name in the job name.
  INFERRED
  /// Could not be determined; needs a human.
  NONE
}

/// Customers, reconstructed from the legacy "Comapny Name, Address & Mobile"
/// column of the May-2025 Jobs Data sheet. That single column mixed company
/// name, postal address and one or more phone numbers; the importer splits it.
/// Text fields carry the literal string 'NA' where the sheet had no value.
model Customer {
  id String @id @default(cuid())

  companyName   String @map("company_name")
  contactPerson String @default("NA") @map("contact_person")
  address       String @default("NA")
  city          String @default("NA")
  district      String @default("NA")
  pincode       String @default("NA")
  mobile        String @default("NA")
  /// GSTIN. 'NA' where unknown, matching the rest of the imported text fields.
  gstNumber     String @default("NA") @map("gst_number")
  altPhone      String @default("NA") @map("alt_phone")
  email         String @default("NA")

  /// The untouched source string, kept so any parsing decision can be audited
  /// or re-derived without going back to the CSV.
  sourceRaw String @map("source_raw")

  /// False when the importer had to guess, or the source was incomplete.
  /// The office team confirms these inside the app.
  isVerified Boolean @default(false) @map("is_verified")

  source CustomerSource @default(SHEET)

  jobs       Job[]
  quotations Quotation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyName])
  @@index([mobile])
  @@map("customers")
}

/// One row per job in the legacy sheet — the product/spec master that
/// quotations are costed against.
///
/// `jobCode` is deliberately NOT unique: 13 codes are reused across 36 rows in
/// the source sheet for genuinely different jobs. The surrogate `id` is the key
/// until the client confirms the correct codes.
model Job {
  id String @id @default(cuid())

  jobCode String @default("NA") @map("job_code")
  jobName String @default("NA") @map("job_name")
  jobType String @default("NA") @map("job_type")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerSource JobCustomerSource @default(NONE) @map("customer_source")

  /// True when no customer could be determined and the office team must assign
  /// one. Surfaced as a worklist in the app.
  needsCustomer Boolean @default(false) @map("needs_customer")

  // ---- Structure -----------------------------------------------------------
  pouchType         String   @default("NA") @map("pouch_type")
  petMicron         Decimal? @map("pet_micron") @db.Decimal(10, 3)
  metPetMicron      Decimal? @map("met_pet_micron") @db.Decimal(10, 3)
  polyMicron        Decimal? @map("poly_micron") @db.Decimal(10, 3)
  polyType          String   @default("NA") @map("poly_type")
  layer             Decimal? @db.Decimal(10, 3)
  jobFinalDirection String   @default("NA") @map("job_final_direction")
  printingType      String   @default("NA") @map("printing_type")

  // ---- Design --------------------------------------------------------------
  designHeight    Decimal? @map("design_height") @db.Decimal(10, 3)
  designOpenWidth Decimal? @map("design_open_width") @db.Decimal(10, 3)
  ups             Decimal? @db.Decimal(10, 3)
  design          String   @default("NA")
  jobColours      String   @default("NA") @map("job_colours")
  totalCylinders  Decimal? @map("total_cylinders") @db.Decimal(10, 3)

  // ---- GSM -----------------------------------------------------------------
  inkGsm       Decimal? @map("ink_gsm") @db.Decimal(10, 3)
  petGsm       Decimal? @map("pet_gsm") @db.Decimal(10, 3)
  metPetGsm    Decimal? @map("met_pet_gsm") @db.Decimal(10, 3)
  polyGsm      Decimal? @map("poly_gsm") @db.Decimal(10, 3)
  adhesiveGsm  Decimal? @map("adhesive_gsm") @db.Decimal(10, 3)
  compositeGsm Decimal? @map("composite_gsm") @db.Decimal(10, 3)
  coatingGsm   Decimal? @map("coating_gsm") @db.Decimal(10, 3)

  // ---- Ups / notes (sparse columns in the source sheet) --------------------
  up1          String @default("NA") @map("up_1")
  up2          String @default("NA") @map("up_2")
  up3          String @default("NA") @map("up_3")
  up4          String @default("NA") @map("up_4")
  up2OpenWidth String @default("NA") @map("up_2_open_width")
  up2Height    String @default("NA") @map("up_2_height")
  up3OpenWidth String @default("NA") @map("up_3_open_width")
  notes        String @default("NA")

  // ---- Cylinder / tooling --------------------------------------------------
  rubberSize    Decimal? @map("rubber_size") @db.Decimal(10, 3)
  cylinderCell  Decimal? @map("cylinder_cell") @db.Decimal(10, 3)
  cylinderDia   Decimal? @map("cylinder_dia") @db.Decimal(10, 3)
  cylinderParty String   @default("NA") @map("cylinder_party")

  // ---- Ranges kept as text: the sheet stores values like "15-16", "60-70" ---
  viscosity        String @default("NA")
  singleRollWeight String @default("NA") @map("single_roll_weight")
  pouchPlateSize   String @default("NA") @map("pouch_plate_size")
  pouchesPerKg     String @default("NA") @map("pouches_per_kg")

  // ---- Pouch dimensions ----------------------------------------------------
  dPunch         String   @default("NA") @map("d_punch")
  dPunchTopSize  String   @default("NA") @map("d_punch_top_size")
  pouchSubType   String   @default("NA") @map("pouch_sub_type")
  pouchHeight    Decimal? @map("pouch_height") @db.Decimal(10, 3)
  pouchOpenWidth Decimal? @map("pouch_open_width") @db.Decimal(10, 3)
  gusset         String   @default("NA")
  gussetSize     String   @default("NA") @map("gusset_size")
  vNotch         String   @default("NA") @map("v_notch")

  /// 1-based row number in the source CSV, so any imported row can be traced
  /// back to the exact line it came from.
  quotationItems QuotationItem[]

  sourceRow Int @map("source_row")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobCode])
  @@index([customerId])
  @@index([needsCustomer])
  @@map("jobs")
}

/// Where a quotation is in its life.
enum QuotationStatus {
  DRAFT
  SENT
  WON
  LOST
}

/// A customer-facing quotation.
///
/// Customer details and every computed figure are SNAPSHOT onto the record
/// rather than looked up live. A quotation that has been sent must never
/// change because someone later edited the customer's address or the cylinder
/// rate moved — the document has to keep saying what it said.
model Quotation {
  id String @id @default(cuid())

  /// Sequential, human-facing number. Continues the client's existing series.
  number Int      @unique
  date   DateTime @db.Date

  status QuotationStatus @default(DRAFT)

  /// Optional link back to the customer master; the fields below are the snapshot.
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName String @map("customer_name")
  addressLine1 String @default("NA") @map("address_line1")
  addressLine2 String @default("NA") @map("address_line2")
  addressLine3 String @default("NA") @map("address_line3")
  mobile       String @default("NA")
  email        String @default("NA")
  /// Snapshotted with the address: a sent quotation must keep the GSTIN it was
  /// issued against, even if the customer master is corrected later.
  gstNumber    String @default("NA") @map("gst_number")

  /// Rates as they stood when this quotation was made.
  cylinderRate           Decimal @map("cylinder_rate") @db.Decimal(10, 4)
  gstPercent             Decimal @map("gst_percent") @db.Decimal(5, 2)
  materialAdvancePercent Decimal @map("material_advance_percent") @db.Decimal(5, 2)
  cylinderAdvancePercent Decimal @map("cylinder_advance_percent") @db.Decimal(5, 2)

  /// Stored totals, so a saved document never recomputes.
  materialSubtotal Decimal @map("material_subtotal") @db.Decimal(14, 2)
  materialWithGst  Decimal @map("material_with_gst") @db.Decimal(14, 2)
  cylinderSubtotal Decimal @map("cylinder_subtotal") @db.Decimal(14, 2)
  cylinderWithGst  Decimal @map("cylinder_with_gst") @db.Decimal(14, 2)
  grandSubtotal    Decimal @map("grand_subtotal") @db.Decimal(14, 2)
  grandWithGst     Decimal @map("grand_with_gst") @db.Decimal(14, 2)
  materialAdvance  Decimal @map("material_advance") @db.Decimal(14, 2)
  cylinderAdvance  Decimal @map("cylinder_advance") @db.Decimal(14, 2)
  totalAdvance     Decimal @map("total_advance") @db.Decimal(14, 2)

  /// Printed terms. Stored per quotation so wording can change over time.
  terms String[]
  notes String   @default("")

  /// Set the first time the quotation is marked as sent.
  sentAt DateTime? @map("sent_at")

  items  QuotationItem[]
  emails QuotationEmail[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

/// One priced line on a quotation.
model QuotationItem {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// Order on the printed document.
  position Int

  /// Optional link to the job this line was prefilled from.
  jobId String? @map("job_id")
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  jobName String @map("job_name")

  /// Roll or pouch, and for a pouch which style. Defaults to POUCH because
  /// every imported line is one — a roll is the newer, rarer case.
  jobKind JobKind @default(POUCH) @map("job_kind")

  /// Null on a roll. On a pouch it is the style; OTHER pairs with the note.
  pouchType PouchType? @map("pouch_type")

  /// Free text, only meaningful when pouchType is OTHER.
  pouchTypeNote String @default("") @map("pouch_type_note")

  /// The film this line is costed against. Optional: a quotation can be priced
  /// without a material cost, and retiring a material must not erase old lines.
  filmMaterialId String?   @map("film_material_id")
  filmMaterial   Material? @relation(fields: [filmMaterialId], references: [id], onDelete: SetNull)

  // ---- Inputs -------------------------------------------------------------
  layer         Int
  widthMm       Decimal @map("width_mm") @db.Decimal(10, 2)
  heightMm      Decimal @map("height_mm") @db.Decimal(10, 2)
  polyMicron    Decimal @map("poly_micron") @db.Decimal(10, 2)
  quantityKg    Decimal @map("quantity_kg") @db.Decimal(12, 3)
  ratePerKg     Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  repeatWidth   Decimal @map("repeat_width") @db.Decimal(10, 2)
  repeatHeight  Decimal @map("repeat_height") @db.Decimal(10, 2)
  cylinderCount Int     @map("cylinder_count")
  transportCost Decimal @default(0) @map("transport_cost") @db.Decimal(12, 2)

  // ---- Computed, stored so the document is immutable ----------------------
  micron                Decimal @db.Decimal(10, 2)
  pouchesPerKg          Decimal @map("pouches_per_kg") @db.Decimal(12, 2)
  totalPouches          Decimal @map("total_pouches") @db.Decimal(14, 2)
  totalAmount           Decimal @map("total_amount") @db.Decimal(14, 2)
  cylinderWidth         Decimal @map("cylinder_width") @db.Decimal(10, 2)
  cylinderCircumference Decimal @map("cylinder_circumference") @db.Decimal(10, 2)
  costPerCylinder       Decimal @map("cost_per_cylinder") @db.Decimal(14, 2)
  totalCylinderCost     Decimal @map("total_cylinder_cost") @db.Decimal(14, 2)
  costPerPouch          Decimal @map("cost_per_pouch") @db.Decimal(12, 4)

  // ---- Material costing, from the rates that applied on the quotation date --
  /// Null when no film was chosen, or no rate existed for it that day.
  materialCostPerKg Decimal? @map("material_cost_per_kg") @db.Decimal(12, 4)
  materialCost      Decimal? @map("material_cost") @db.Decimal(14, 2)
  /// (selling - cost) / selling, as a percentage.
  marginPercent     Decimal? @map("margin_percent") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quotationId])
  @@map("quotation_items")
}

/// Editable system settings — cylinder rate, GST %, default advance rates.
/// Kept as key/value so a new setting does not need a migration.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Broad grouping for the rates screen.
enum MaterialCategory {
  FILM
  INK
  ADHESIVE
  SOLVENT
  CONSUMABLE
}

/// A raw material whose price is tracked. Editable by the office: suppliers
/// and specifications change, and adding a film should not need a developer.
model Material {
  id String @id @default(cuid())

  name     String           @unique
  category MaterialCategory
  /// KG for films, inks and adhesives; L for solvents.
  unit     String           @default("KG")

  /**
   * g/cm³. Turns a film's thickness into weight: a 12µ PET at 1.4 is 16.8 GSM,
   * which is exactly what the imported jobs show on 404 rows. Without it a
   * micron figure cannot be costed, because price is per kilogram.
   */
  density Decimal? @db.Decimal(6, 4)

  /// Retired materials stay for the sake of old quotations but leave the form.
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  rates          MaterialRate[]
  quotationItems QuotationItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, sortOrder])
  @@map("materials")
}

/// One material's price on one day.
///
/// A dated row per change rather than a single mutable price: the office keys
/// rates in most mornings, quotations must stay costed against the rate that
/// applied when they were made, and the day-on-day delta comes free.
model MaterialRate {
  id String @id @default(cuid())

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  rate          Decimal  @db.Decimal(12, 4)
  effectiveDate DateTime @map("effective_date") @db.Date

  /// Who keyed it in. Free text until there are user accounts.
  enteredBy String @default("Office") @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([materialId, effectiveDate])
  @@index([effectiveDate])
  @@map("material_rates")
}

/// A person who can sign in.
///
/// Access is deliberately two-tier and nothing more: `isAdmin` reaches
/// everything, and everyone else is limited to the modules listed in
/// `modules`. There is no role vocabulary, because the office has one admin
/// and a handful of staff, and a role table would be scaffolding around a
/// decision nobody needs to make.
model User {
  id String @id @default(cuid())

  /// Stored lower-case, so "Anand" and "anand" cannot become two accounts.
  username String @unique

  /// scrypt, salted per user. Never leaves the API — no response type
  /// includes it, so it cannot escape by being spread into one.
  passwordHash String @map("password_hash")

  displayName String  @map("display_name")
  isAdmin     Boolean @default(false) @map("is_admin")

  /// A deactivated user keeps their history but cannot sign in, and their
  /// sessions are dropped. Preferred over deletion: quotations record who
  /// entered a rate, and that reference should not rot.
  isActive Boolean @default(true) @map("is_active")

  /// Module keys from APP_MODULES in @yuva/shared. A plain array rather than a
  /// join table — the list is four items long and always read whole.
  modules String[] @default([])

  lastLoginAt DateTime? @map("last_login_at")

  sessions Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// An active sign-in.
///
/// The token itself is never stored — only its SHA-256 — so a leaked database
/// dump cannot be replayed as a live session. Deleting the row signs that
/// session out immediately, which is the whole reason for keeping sessions in
/// the database rather than encoding them into a token.
model Session {
  id String @id @default(cuid())

  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One attempt to email a quotation to somebody.
///
/// Kept as history rather than a pair of columns on the quotation, because a
/// quotation is commonly revised and sent again — to a different person, or to
/// the same one twice — and "who has actually seen this, and when" is a
/// question the office asks. `Quotation.sentAt` still records the first send.
model QuotationEmail {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// Recipients as typed, so the record shows what was actually sent where.
  to      String[]
  cc      String[]
  subject String

  /// Resend's id for the message, for chasing a delivery with their dashboard.
  providerId String? @map("provider_id")

  /// Display name of whoever pressed send. Free text, matching `entered_by`
  /// on rates — a deleted user should not orphan the record.
  sentBy String @map("sent_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quotationId, createdAt])
  @@map("quotation_emails")
}
