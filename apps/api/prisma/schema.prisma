// Yuva Polyprint ERP — database schema
//
// Conventions:
//   - Model names PascalCase singular; tables snake_case plural via @@map
//   - Columns snake_case via @map
//   - Every table: id (cuid), createdAt, updatedAt
//   - Money and material quantities use Decimal, never Float
//   - Enums for status vocabularies rather than free-text strings
//
// The datasource URL is supplied by prisma.config.ts from DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// How a quotation line is sold.
enum PricingBasis {
  /// Rolls and most pouch styles.
  PER_KG
  /// Standup and standup-zipper pouches, which the trade quotes per piece.
  PER_POUCH
}

/// What the customer physically receives.
enum JobKind {
  /// Printed film on the reel.
  ROLL
  /// Film converted into a bag.
  POUCH
}

/// Pouch styles the works produces. OTHER carries a free-text note alongside,
/// because a fixed list that cannot describe a real order is worse than none.
enum PouchType {
  STANDUP
  STANDUP_ZIPPER
  ZIPPER
  /// A punched D-shaped carry hole. Its own style because the punch is its own
  /// charge on top of making, which is what the works' pouch workbook shows.
  D_PUNCH
  SPOUT
  CENTRE_SEAL
  THREE_SIDE_SEAL
  OTHER
}

/// How a customer record came into existence.
enum CustomerSource {
  /// Company details were written in the sheet's combined customer column.
  SHEET
  /// Provisional: created from a brand name recurring in job names, because
  /// the sheet never recorded the company. Contact details are 'NA'.
  BRAND_INFERRED
}

/// How a job's customer was determined.
enum JobCustomerSource {
  /// Named on the job's own row.
  EXPLICIT
  /// Matched through the brand name in the job name.
  INFERRED
  /// Could not be determined; needs a human.
  NONE
}

/// Customers, reconstructed from the legacy "Comapny Name, Address & Mobile"
/// column of the May-2025 Jobs Data sheet. That single column mixed company
/// name, postal address and one or more phone numbers; the importer splits it.
/// Text fields carry the literal string 'NA' where the sheet had no value.
model Customer {
  id String @id @default(cuid())

  companyName   String @map("company_name")
  /// The brand this company sells under, where that differs from its
  /// registered name. A proprietorship registers as a person and trades as a
  /// brand, and the office knows most customers by the second — so this is what
  /// the customer list and the quotation show, and `companyName` stays the name
  /// that belongs on an invoice.
  brandName     String @default("NA") @map("brand_name")
  contactPerson String @default("NA") @map("contact_person")
  address       String @default("NA")
  city          String @default("NA")
  district      String @default("NA")
  pincode       String @default("NA")
  mobile        String @default("NA")
  /// GSTIN. 'NA' where unknown, matching the rest of the imported text fields.
  gstNumber     String @default("NA") @map("gst_number")
  altPhone      String @default("NA") @map("alt_phone")
  email         String @default("NA")

  /// The untouched source string, kept so any parsing decision can be audited
  /// or re-derived without going back to the CSV.
  sourceRaw String @map("source_raw")

  /// False when the importer had to guess, or the source was incomplete.
  /// The office team confirms these inside the app.
  isVerified Boolean @default(false) @map("is_verified")

  source CustomerSource @default(SHEET)

  jobs       Job[]
  quotations Quotation[]
  orders     Order[]
  /// Deliveries made to them. One note is one lorry.
  dispatches Dispatch[]

  /// Runs costed against this customer's designs.
  jobSheets JobSheet[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyName])
  @@index([mobile])
  @@map("customers")
}

/// One row per job in the legacy sheet — the product/spec master that
/// quotations are costed against.
///
/// `jobCode` is deliberately NOT unique: 13 codes are reused across 36 rows in
/// the source sheet for genuinely different jobs. The surrogate `id` is the key
/// until the client confirms the correct codes.
model Job {
  id String @id @default(cuid())

  jobCode String @default("NA") @map("job_code")
  jobName String @default("NA") @map("job_name")
  jobType String @default("NA") @map("job_type")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerSource JobCustomerSource @default(NONE) @map("customer_source")

  /// True when no customer could be determined and the office team must assign
  /// one. Surfaced as a worklist in the app.
  needsCustomer Boolean @default(false) @map("needs_customer")

  // ---- Structure -----------------------------------------------------------
  pouchType         String   @default("NA") @map("pouch_type")
  petMicron         Decimal? @map("pet_micron") @db.Decimal(10, 3)
  metPetMicron      Decimal? @map("met_pet_micron") @db.Decimal(10, 3)
  polyMicron        Decimal? @map("poly_micron") @db.Decimal(10, 3)
  polyType          String   @default("NA") @map("poly_type")
  layer             Decimal? @db.Decimal(10, 3)
  jobFinalDirection String   @default("NA") @map("job_final_direction")
  printingType      String   @default("NA") @map("printing_type")

  // ---- Design --------------------------------------------------------------
  designHeight    Decimal? @map("design_height") @db.Decimal(10, 3)
  designOpenWidth Decimal? @map("design_open_width") @db.Decimal(10, 3)
  ups             Decimal? @db.Decimal(10, 3)
  design          String   @default("NA")
  jobColours      String   @default("NA") @map("job_colours")
  totalCylinders  Decimal? @map("total_cylinders") @db.Decimal(10, 3)

  // ---- GSM -----------------------------------------------------------------
  inkGsm       Decimal? @map("ink_gsm") @db.Decimal(10, 3)
  petGsm       Decimal? @map("pet_gsm") @db.Decimal(10, 3)
  metPetGsm    Decimal? @map("met_pet_gsm") @db.Decimal(10, 3)
  polyGsm      Decimal? @map("poly_gsm") @db.Decimal(10, 3)
  adhesiveGsm  Decimal? @map("adhesive_gsm") @db.Decimal(10, 3)
  compositeGsm Decimal? @map("composite_gsm") @db.Decimal(10, 3)
  coatingGsm   Decimal? @map("coating_gsm") @db.Decimal(10, 3)

  // ---- Ups / notes (sparse columns in the source sheet) --------------------
  up1          String @default("NA") @map("up_1")
  up2          String @default("NA") @map("up_2")
  up3          String @default("NA") @map("up_3")
  up4          String @default("NA") @map("up_4")
  up2OpenWidth String @default("NA") @map("up_2_open_width")
  up2Height    String @default("NA") @map("up_2_height")
  up3OpenWidth String @default("NA") @map("up_3_open_width")
  notes        String @default("NA")

  // ---- Cylinder / tooling --------------------------------------------------
  rubberSize    Decimal? @map("rubber_size") @db.Decimal(10, 3)
  cylinderCell  Decimal? @map("cylinder_cell") @db.Decimal(10, 3)
  cylinderDia   Decimal? @map("cylinder_dia") @db.Decimal(10, 3)
  cylinderParty String   @default("NA") @map("cylinder_party")

  // ---- Ranges kept as text: the sheet stores values like "15-16", "60-70" ---
  viscosity        String @default("NA")
  singleRollWeight String @default("NA") @map("single_roll_weight")
  pouchPlateSize   String @default("NA") @map("pouch_plate_size")
  pouchesPerKg     String @default("NA") @map("pouches_per_kg")

  // ---- Pouch dimensions ----------------------------------------------------
  dPunch         String   @default("NA") @map("d_punch")
  dPunchTopSize  String   @default("NA") @map("d_punch_top_size")
  pouchSubType   String   @default("NA") @map("pouch_sub_type")
  pouchHeight    Decimal? @map("pouch_height") @db.Decimal(10, 3)
  pouchOpenWidth Decimal? @map("pouch_open_width") @db.Decimal(10, 3)
  gusset         String   @default("NA")
  gussetSize     String   @default("NA") @map("gusset_size")
  vNotch         String   @default("NA") @map("v_notch")

  /// 1-based row number in the source CSV, so any imported row can be traced
  /// back to the exact line it came from.
  quotationItems   QuotationItem[]
  /// Material issued against this design. Nullable on that side, so retiring a
  /// job leaves the stock ledger readable.
  stockMovements   StockMovement[]
  /// The engraved set this design prints from. A job is the design — see the
  /// Cylinder model.
  cylinders        Cylinder[]
  /// The files it prints from. See the JobArtwork model.
  artwork          JobArtwork[]
  /// Every run of this design, and what each actually cost.
  jobSheets        JobSheet[]
  orders           Order[]
  productionOrders ProductionOrder[]

  sourceRow Int @map("source_row")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobCode])
  @@index([customerId])
  @@index([needsCustomer])
  @@map("jobs")
}

/// Where a quotation is in its life.
enum QuotationStatus {
  DRAFT
  SENT
  WON
  LOST
}

/// A customer-facing quotation.
///
/// Customer details and every computed figure are SNAPSHOT onto the record
/// rather than looked up live. A quotation that has been sent must never
/// change because someone later edited the customer's address or the cylinder
/// rate moved — the document has to keep saying what it said.
model Quotation {
  id String @id @default(cuid())

  /// Sequential, human-facing number. Continues the client's existing series.
  /// Not unique on its own — a revision keeps the number and bumps the version.
  number Int
  date   DateTime @db.Date

  /// Revisions of one quotation. The office reprices rather than renumbers: the
  /// customer already has "QUO-124" on their desk, and a second document with a
  /// different number reads as a second offer rather than a corrected one.
  version Int @default(1)

  /// The first version, which every later one hangs off. Null on v1 itself.
  rootId String?    @map("root_id")
  root   Quotation? @relation("QuotationVersions", fields: [rootId], references: [id], onDelete: Cascade)

  versions Quotation[] @relation("QuotationVersions")

  /// True for the newest version of a number. Denormalised so the list stays a
  /// plain filter rather than a correlated subquery against every row; written
  /// in the same transaction that creates a revision, so it cannot drift.
  isLatest Boolean @default(true) @map("is_latest")

  status QuotationStatus @default(DRAFT)

  /// Optional link back to the customer master; the fields below are the snapshot.
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName String @map("customer_name")
  addressLine1 String @default("NA") @map("address_line1")
  addressLine2 String @default("NA") @map("address_line2")
  addressLine3 String @default("NA") @map("address_line3")
  mobile       String @default("NA")
  email        String @default("NA")
  /// Snapshotted with the address: a sent quotation must keep the GSTIN it was
  /// issued against, even if the customer master is corrected later.
  gstNumber    String @default("NA") @map("gst_number")

  /// Who sent this enquiry the works' way. Empty where nobody did.
  ///
  /// Business arrives through people and the works wants that on the record.
  /// It is recorded and nothing else: not printed on the quotation, not
  /// emailed, not searched. What it is eventually FOR is theirs to decide once
  /// they have a year of it.
  ///
  /// On the QUOTATION rather than the customer because that is the finer grain
  /// — two enquiries from one company can come through different people, and a
  /// per-customer view can be derived from these later, but not the reverse.
  referredBy String @default("") @map("referred_by")

  /// Which quantity the document is for, 1-based, among this quotation's tiers.
  ///
  /// The office may price a job at two or three quantities to see what volume
  /// does to the margin; the customer is quoted one. Stored rather than derived
  /// because it is a decision, and defaulted to 1 so every existing quotation
  /// keeps showing the quantity it was written for.
  selectedQuantity Int @default(1) @map("selected_quantity")

  /// Costing figures this quotation overrides, or null for the works' own.
  ///
  /// The client's own sheets set these by hand job to job — margins of 5%,
  /// 9% and 10%, transport at Rs 5 and Rs 10, pouch making at 0, 11.04 and 15.
  /// Holding one figure for the works made their own history unreproducible.
  ///
  /// Wastage joined them when the works gave a second figure for it: 7% on the
  /// pouch jobs its pouch workbook covers, 8% on everything else, where one
  /// number had been read from the Estimation sheet. The seven 2022 quotations
  /// rebuilt from that sheet set it here, so they keep reproducing whatever the
  /// works' own default becomes.
  marginPercent    Decimal? @map("margin_percent") @db.Decimal(5, 2)
  transportPerKg   Decimal? @map("transport_per_kg") @db.Decimal(10, 2)
  pouchMakingPerKg Decimal? @map("pouch_making_per_kg") @db.Decimal(10, 2)
  wastagePercent   Decimal? @map("wastage_percent") @db.Decimal(5, 2)

  /// Rates as they stood when this quotation was made.
  cylinderRate           Decimal @map("cylinder_rate") @db.Decimal(10, 4)
  gstPercent             Decimal @map("gst_percent") @db.Decimal(5, 2)
  materialAdvancePercent Decimal @map("material_advance_percent") @db.Decimal(5, 2)
  cylinderAdvancePercent Decimal @map("cylinder_advance_percent") @db.Decimal(5, 2)

  /// Totals live on the tiers, because a quotation may carry two or three
  /// quantities side by side and each one has its own.

  /// Printed terms. Stored per quotation so wording can change over time.
  terms String[]
  notes String   @default("")

  /// Set the first time the quotation is marked as sent.
  sentAt DateTime? @map("sent_at")

  /// When the customer's answer was recorded, won or lost.
  decidedAt DateTime? @map("decided_at")

  /// Why the customer said no. Only meaningful on a LOST quotation, and the
  /// point of recording an outcome at all — "we lost it" teaches nothing;
  /// "price was 8% over the incumbent" does.
  lostReason String @default("") @map("lost_reason")

  /// Which quantity the customer accepted. Only set on a WON quotation — with
  /// three prices on one document, "won" alone does not say what was agreed.
  wonTierId String?        @unique @map("won_tier_id")
  wonTier   QuotationTier? @relation("WonTier", fields: [wonTierId], references: [id], onDelete: SetNull)

  tiers  QuotationTier[]  @relation("QuotationTiers")
  items  QuotationItem[]
  emails QuotationEmail[]
  /// What the customer actually ordered off it, once it was won.
  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([number, version])
  @@index([customerId])
  @@index([status])
  @@index([number])
  @@index([isLatest])
  @@map("quotations")
}

/// One quantity a quotation is priced at.
///
/// The customer is shown two or three order sizes side by side so they can see
/// what ordering more does to the unit price. The cylinders cost the same
/// whichever they choose — that is the whole reason the per-pouch figure falls.
model QuotationTier {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation("QuotationTiers", fields: [quotationId], references: [id], onDelete: Cascade)

  /// 1, 2, 3 — the order the columns are printed in, smallest first.
  position Int

  /// Stored totals, so a saved document never recomputes.
  materialSubtotal Decimal @map("material_subtotal") @db.Decimal(14, 2)
  materialWithGst  Decimal @map("material_with_gst") @db.Decimal(14, 2)
  cylinderSubtotal Decimal @map("cylinder_subtotal") @db.Decimal(14, 2)
  cylinderWithGst  Decimal @map("cylinder_with_gst") @db.Decimal(14, 2)
  grandSubtotal    Decimal @map("grand_subtotal") @db.Decimal(14, 2)
  grandWithGst     Decimal @map("grand_with_gst") @db.Decimal(14, 2)
  materialAdvance  Decimal @map("material_advance") @db.Decimal(14, 2)
  cylinderAdvance  Decimal @map("cylinder_advance") @db.Decimal(14, 2)
  totalAdvance     Decimal @map("total_advance") @db.Decimal(14, 2)

  /// Summed across the lines, for the header of the printed column.
  totalQuantityKg Decimal @map("total_quantity_kg") @db.Decimal(14, 3)
  totalPouches    Decimal @map("total_pouches") @db.Decimal(14, 2)

  quantities QuotationItemQuantity[]
  wonBy      Quotation?              @relation("WonTier")

  @@unique([quotationId, position])
  @@map("quotation_tiers")
}

/// One priced line on a quotation.
model QuotationItem {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// Order on the printed document.
  position Int

  /// Optional link to the job this line was prefilled from.
  jobId String? @map("job_id")
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  jobName String @map("job_name")

  /// Roll or pouch, and for a pouch which style. Defaults to POUCH because
  /// every imported line is one — a roll is the newer, rarer case.
  jobKind JobKind @default(POUCH) @map("job_kind")

  /// Null on a roll. On a pouch it is the style; OTHER pairs with the note.
  pouchType PouchType? @map("pouch_type")

  /// Free text, only meaningful when pouchType is OTHER.
  pouchTypeNote String @default("") @map("pouch_type_note")

  // ---- The design --------------------------------------------------------
  widthMm  Decimal @map("width_mm") @db.Decimal(10, 2)
  heightMm Decimal @map("height_mm") @db.Decimal(10, 2)

  /// A gazette pouch gussets at the sides and the base so it stands. The three
  /// depths below are film the flat sheet has to carry, so they enlarge both
  /// the weight and the cylinder — see computeItemGeometry in @yuva/shared.
  /// Stored rather than derived, because a quotation has to be able to
  /// reproduce its own figures years later.
  isGazette     Boolean @default(false) @map("is_gazette")
  gazetteBottom Decimal @default(0) @map("gazette_bottom") @db.Decimal(10, 2)
  gazetteLeft   Decimal @default(0) @map("gazette_left") @db.Decimal(10, 2)
  gazetteRight  Decimal @default(0) @map("gazette_right") @db.Decimal(10, 2)

  /// The flat film one pouch is cut from — the pouch plus its gussets. Equal to
  /// width and height on an ordinary bag; larger on a gazette. Stored because
  /// it is what the printed document and the machine both work from.
  filmWidthMm  Decimal      @map("film_width_mm") @db.Decimal(10, 2)
  filmHeightMm Decimal      @map("film_height_mm") @db.Decimal(10, 2)
  /// Derived from the pouch style; stored so a saved line keeps the basis it
  /// was priced on even if the style is edited later.
  pricingBasis PricingBasis @default(PER_KG) @map("pricing_basis")

  // ---- Cylinders ----------------------------------------------------------
  repeatWidth   Decimal @map("repeat_width") @db.Decimal(10, 2)
  repeatHeight  Decimal @map("repeat_height") @db.Decimal(10, 2)
  cylinderCount Int     @map("cylinder_count")
  transportCost Decimal @default(0) @map("transport_cost") @db.Decimal(12, 2)

  /// False when this design's cylinders already exist in the works, so nothing
  /// is charged for them. Per design, not per customer: a customer of ten years
  /// ordering a new pouch still needs a new set engraved, and the printed terms
  /// say so — "each job/design requires a separate cylinder".
  chargeCylinders Boolean @default(true) @map("charge_cylinders")

  // ---- Computed geometry, the same at every quantity ----------------------
  micron                Decimal @db.Decimal(10, 2)
  pouchesPerKg          Decimal @map("pouches_per_kg") @db.Decimal(12, 2)
  cylinderWidth         Decimal @map("cylinder_width") @db.Decimal(10, 2)
  cylinderCircumference Decimal @map("cylinder_circumference") @db.Decimal(10, 2)
  costPerCylinder       Decimal @map("cost_per_cylinder") @db.Decimal(14, 2)
  totalCylinderCost     Decimal @map("total_cylinder_cost") @db.Decimal(14, 2)

  // ---- Material costing, from the rates that applied on the quotation date --
  /// Null when a ply was left unchosen, or no rate existed for it that day.
  materialCostPerKg Decimal? @map("material_cost_per_kg") @db.Decimal(12, 4)
  /// Weight of one square metre of the finished laminate.
  compositeGsm      Decimal  @default(0) @map("composite_gsm") @db.Decimal(10, 3)

  layers     QuotationItemLayer[]
  colours    QuotationItemColour[]
  quantities QuotationItemQuantity[]

  createdAt DateTime @default(now()) @map("created_at")
  /// The order this line became, if the quotation was won.
  order     Order?

  @@index([quotationId])
  @@map("quotation_items")
}

/// One ply of a line's laminate.
///
/// Replaces the old fixed structure — one PET, a metallised PET on a 3-layer
/// job, then whichever film was picked for the sealant. That was what the works
/// produces today rather than what it can produce, and a 19-micron PET or a
/// foil ply needed a developer. The plies are now stated on the quotation.
///
/// Everything is snapshotted alongside the material link, because a quotation
/// is a document: the rate it was costed against must not move when the rate
/// screen is updated tomorrow, and retiring a material must not erase history.
/// Which ink a printing station carries on this line.
///
/// A line starts with the four process colours, and the office takes away the
/// ones the job does not print — plenty of jobs are one colour — and adds a
/// SPECIAL for each station that will carry something else. What that something
/// is nobody knows while quoting: the brand's red, a metallic, a white base
/// coat. It is decided at artwork, long after the price has been given.
///
/// So a special is priced at the **dearest ink on the rates list**, which is
/// the only honest assumption available: quote the cheapest and the works loses
/// the difference on every job where it guessed low.
///
/// Snapshotted like a ply, and for the same reason. The rate, laydown and
/// solids are what they were the day the quotation was written, so reopening it
/// in a year shows what was quoted rather than what it would cost now.
model QuotationItemColour {
  id String @id @default(cuid())

  itemId String        @map("item_id")
  item   QuotationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Order on the screen. Not the station it runs on — that is the press's
  /// business and the office does not choose it here.
  position Int

  /// The ink, where one was named. Null on a SPECIAL, which names no ink by
  /// definition, and on a process colour whose material was later deleted.
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  /// 'Cyan', or 'Special colour'. What the quotation says it printed.
  name String

  /// PROCESS or SPECIAL. Stored rather than read from the name, because a works
  /// may well call its own spot colour "Cyan (Pantone 2995)".
  kind InkKind

  /// What it was priced at, as it stood that day.
  laydownGsm    Decimal @map("laydown_gsm") @db.Decimal(6, 3)
  solidsPercent Decimal @map("solids_percent") @db.Decimal(6, 3)
  ratePerKg     Decimal @map("rate_per_kg") @db.Decimal(12, 2)

  @@unique([itemId, position])
  @@index([materialId])
  @@map("quotation_item_colours")
}

model QuotationItemLayer {
  id String @id @default(cuid())

  itemId String        @map("item_id")
  item   QuotationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// 1 is the outermost, printed ply.
  position Int

  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  materialName String   @map("material_name")
  micron       Decimal  @db.Decimal(10, 2)
  /// g/cm³ as it stood. Null when the material has none recorded, in which case
  /// the line cannot be costed at all rather than costed as if the ply weighed
  /// nothing.
  density      Decimal? @db.Decimal(6, 4)
  ratePerKg    Decimal? @map("rate_per_kg") @db.Decimal(12, 2)

  /// The rate the office agreed for this job's film, when they typed one.
  ///
  /// Null means "use the film's own rate". Stated rather than deduced: a typed
  /// rate used to be inferred from the ply quoting a gauge the material does
  /// not name, which held while an unstocked gauge was the only reason to type
  /// one. Film prices turn out to be agreed per job — the works' sheets carry
  /// PET at 185, 175 and 190, all at 12µ and all on the same day — and at the
  /// stocked gauge such a rate was stored and then invisible, so reopening the
  /// quotation and saving replaced it with the catalogue price.
  ///
  /// Null on every row written before this existed; those are read through the
  /// old inference, so nothing already saved moves.
  rateOverride Decimal? @map("rate_override") @db.Decimal(12, 2)

  /// micron × density, stored so the printed breakdown needs no arithmetic.
  gsm Decimal @db.Decimal(10, 3)

  @@unique([itemId, position])
  @@index([materialId])
  @@map("quotation_item_layers")
}

/// One line's figures at one quantity.
model QuotationItemQuantity {
  id String @id @default(cuid())

  itemId String        @map("item_id")
  item   QuotationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  tierId String        @map("tier_id")
  tier   QuotationTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  /// Matches the tier's position; kept so a line orders without a join.
  position Int

  /// Both units are always populated — one typed, the other worked out — so
  /// the PDF, the totals and the job records can each read what they need.
  quantityKg      Decimal @map("quantity_kg") @db.Decimal(12, 3)
  ratePerKg       Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  quantityPouches Int     @default(0) @map("quantity_pouches")
  ratePerPouch    Decimal @default(0) @map("rate_per_pouch") @db.Decimal(12, 4)

  totalPouches Decimal @map("total_pouches") @db.Decimal(14, 2)
  totalAmount  Decimal @map("total_amount") @db.Decimal(14, 2)
  costPerPouch Decimal @map("cost_per_pouch") @db.Decimal(12, 4)

  /// Cost and margin at this quantity. Null when the line could not be costed.
  materialCost  Decimal? @map("material_cost") @db.Decimal(14, 2)
  marginPercent Decimal? @map("margin_percent") @db.Decimal(6, 2)

  @@unique([itemId, position])
  @@index([tierId])
  @@map("quotation_item_quantities")
}

/// Editable system settings — cylinder rate, GST %, default advance rates.
/// Kept as key/value so a new setting does not need a migration.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// What a setting was on a given day.
///
/// The works' own sheets carry a bank EMI of Rs 4,166.66 in March and April
/// 2022 and Rs 10,000 in July — one figure, changed in between, not something
/// that varies job to job. Material rates already answer "what was this worth
/// then"; settings could not, so an old quotation repriced at today's
/// overheads and could never reproduce itself.
///
/// `AppSetting` remains the current value — and is also where the GSTIN lookup
/// cache lives, which is why this sits beside it rather than replacing it. A
/// key with no history here simply never changed.
model AppSettingHistory {
  key   String
  value String

  /// The day this value came into force.
  effectiveDate DateTime @map("effective_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@id([key, effectiveDate])
  @@index([key, effectiveDate(sort: Desc)])
  @@map("app_setting_history")
}

/// Broad grouping for the rates screen.
enum MaterialCategory {
  FILM
  INK
  ADHESIVE
  SOLVENT
  CONSUMABLE
}

/// A raw material whose price is tracked. Editable by the office: suppliers
/// and specifications change, and adding a film should not need a developer.
model Material {
  id String @id @default(cuid())

  name     String           @unique
  category MaterialCategory
  /// KG for films, inks and adhesives; L for solvents.
  unit     String           @default("KG")

  /**
   * g/cm³. Turns a film's thickness into weight: a 12µ PET at 1.4 is 16.8 GSM,
   * which is exactly what the imported jobs show on 404 rows. Without it a
   * micron figure cannot be costed, because price is per kilogram.
   */
  density Decimal? @db.Decimal(6, 4)

  /**
   * What share of the tin is pigment or resin, for inks and adhesives.
   * The rest evaporates, so the works buys several kilograms of liquid for
   * every kilogram that stays on the film. Costing a laydown against the
   * purchase rate without this understates ink by three to five times. Null
   * for films, which are what they weigh.
   */
  solidsPercent Decimal? @map("solids_percent") @db.Decimal(6, 3)

  /**
   * Dry ink this colour lays down, g/m². White is an opaque base coat and runs
   * an order of magnitude heavier than a process colour — 1.8 against 0.15 —
   * so one figure for "ink" cannot price a job that uses both.
   */
  laydownGsm Decimal? @map("laydown_gsm") @db.Decimal(6, 3)

  /**
   * Process or special, for inks. Null on anything that is not an ink.
   * Cyan, magenta, yellow and black are the four every press carries and every
   * job may use. Everything else is a job's own decision — a white base coat,
   * a brand's Pantone, a metallic — and belongs to the works only once
   * somebody has bought a tin of it. The distinction is stored rather than
   * inferred from the name, because "Ink — Cyan" and "Cyan (Sun Chemical)" are
   * the same colour and a rule that reads names would disagree.
   */
  inkKind InkKind? @map("ink_kind")

  /**
   * Stock at or below this reads as low. Null means nobody has set one, which
   * is not the same as zero — a material with no level never raises an alarm,
   * where a level of 0 would mean "only shout when we have run out".
   */
  reorderLevel Decimal? @map("reorder_level") @db.Decimal(14, 3)

  /// Retired materials stay for the sake of old quotations but leave the form.
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  rates                MaterialRate[]
  /// Plies quoted against this material. The link is nullable on that side, so
  /// retiring a material leaves old quotations readable.
  quotationItemLayers  QuotationItemLayer[]
  quotationItemColours QuotationItemColour[]
  stockBatches         StockBatch[]
  stockMovements       StockMovement[]
  purchaseOrderLines   PurchaseOrderLine[]

  /// Every job sheet line priced from this material.
  jobSheetLines JobSheetLine[]

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  /// Held against job cards that have not run yet.
  reservations StockReservation[]

  @@index([category, sortOrder])
  @@map("materials")
}

/// One material's price on one day.
///
/// A dated row per change rather than a single mutable price: the office keys
/// rates in most mornings, quotations must stay costed against the rate that
/// applied when they were made, and the day-on-day delta comes free.
model MaterialRate {
  id String @id @default(cuid())

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  rate          Decimal  @db.Decimal(12, 4)
  effectiveDate DateTime @map("effective_date") @db.Date

  /// Who keyed it in. Free text until there are user accounts.
  enteredBy String @default("Office") @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([materialId, effectiveDate])
  @@index([effectiveDate])
  @@map("material_rates")
}

/// A person who can sign in.
///
/// Access is deliberately two-tier and nothing more: `isAdmin` reaches
/// everything, and everyone else is limited to the modules listed in
/// `modules`. There is no role vocabulary, because the office has one admin
/// and a handful of staff, and a role table would be scaffolding around a
/// decision nobody needs to make.
model User {
  id String @id @default(cuid())

  /// Stored lower-case, so "Anand" and "anand" cannot become two accounts.
  username String @unique

  /// scrypt, salted per user. Never leaves the API — no response type
  /// includes it, so it cannot escape by being spread into one.
  passwordHash String @map("password_hash")

  displayName String  @map("display_name")
  isAdmin     Boolean @default(false) @map("is_admin")

  /// A deactivated user keeps their history but cannot sign in, and their
  /// sessions are dropped. Preferred over deletion: quotations record who
  /// entered a rate, and that reference should not rot.
  isActive Boolean @default(true) @map("is_active")

  /// Module keys from APP_MODULES in @yuva/shared. A plain array rather than a
  /// join table — the list is four items long and always read whole.
  modules String[] @default([])

  lastLoginAt DateTime? @map("last_login_at")

  sessions    Session[]
  loginEvents LoginEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// An active sign-in.
///
/// The token itself is never stored — only its SHA-256 — so a leaked database
/// dump cannot be replayed as a live session. Deleting the row signs that
/// session out immediately, which is the whole reason for keeping sessions in
/// the database rather than encoding them into a token.
model Session {
  id String @id @default(cuid())

  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One successful sign-in, kept for good.
///
/// `Session` answers "who is signed in right now" and is deleted the moment it
/// expires. This answers "who has ever signed in", and nothing removes a row —
/// which is the whole point of having both.
///
/// The name is copied in rather than only referenced, because users are deleted
/// outright and the history should outlive the account it describes. The same
/// reasoning as `QuotationEmail.sentBy`.
model LoginEvent {
  id String @id @default(cuid())

  /// Null once the account is deleted; the snapshots below still name them.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Username and display name as they stood at the moment of signing in.
  username    String
  displayName String @map("display_name")

  /// Whoever was in front of the browser. Behind a proxy this is the address
  /// Express resolves under `trust proxy` — see app.ts. Null when it cannot be
  /// determined; a sign-in is never refused for want of these.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  /// The monitor page reads this newest-first, and only ever by date.
  @@index([createdAt])
  @@index([userId])
  @@map("login_events")
}

/// One attempt to email a quotation to somebody.
///
/// Kept as history rather than a pair of columns on the quotation, because a
/// quotation is commonly revised and sent again — to a different person, or to
/// the same one twice — and "who has actually seen this, and when" is a
/// question the office asks. `Quotation.sentAt` still records the first send.
/// One press of Send, and everywhere the quotation was addressed to.
///
/// Named for email because that is the channel that existed first and the one
/// that carries the PDF today; a record now also carries the WhatsApp numbers
/// the same send was meant for. One row per send rather than one per channel,
/// because "who did we send quotation 124 to" is a single question with a
/// single answer, and splitting it would make the history a join.
model QuotationEmail {
  id String @id @default(cuid())

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// Recipients as typed, so the record shows what was actually sent where.
  to      String[]
  cc      String[]
  subject String

  /// Mobile numbers the quotation is to reach over WhatsApp, in E.164.
  ///
  /// Recorded when the office presses send, whether or not WhatsApp has
  /// delivered yet — the numbers are part of what was decided, and losing them
  /// would mean nobody could say afterwards who the quotation was meant for.
  ///
  /// `whatsappSentAt` is null until a message is actually accepted by the
  /// provider, so a record with numbers and no timestamp reads as pending
  /// rather than as delivered. That distinction is the whole reason these are
  /// two columns and not one.
  /// Defaulted so the column could be added ahead of the code that writes it —
  /// the build running at the time inserted rows without it.
  whatsappTo     String[]  @default([]) @map("whatsapp_to")
  whatsappSentAt DateTime? @map("whatsapp_sent_at")

  /// Resend's id for the message, for chasing a delivery with their dashboard.
  providerId String? @map("provider_id")

  /// Display name of whoever pressed send. Free text, matching `entered_by`
  /// on rates — a deleted user should not orphan the record.
  sentBy String @map("sent_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quotationId, createdAt])
  @@map("quotation_emails")
}

/// Where a batch sits, and what a movement did.
///
/// A ledger rather than a stock figure that gets edited: every change to a
/// quantity is a row, and the quantity itself is the sum of them. That is what
/// makes "we are 40 kg short of what the system says" a question with an
/// answer, and it is why movements are never edited or deleted — a mistake is
/// corrected by an ADJUSTMENT that says so, leaving both the error and the
/// correction on the record.
enum StockMovementKind {
  /// Material arrived. The only kind that creates a batch.
  RECEIPT
  /// Taken to the floor for a job.
  ISSUE
  /// Scrapped. Separate from ISSUE because the two answer different questions:
  /// one is what a job consumed, the other is what the works lost.
  WASTE
  /// A cycle count correcting the books to what is physically there.
  ADJUSTMENT
  /// Moved between locations. Changes where stock is, never how much.
  TRANSFER
}

/// One delivery of one material, as it sits in the works.
///
/// Batch rather than roll: how much PET is there, what is it worth, and is it
/// running out are the questions the office actually asks, and they are
/// answered per batch. Roll numbers become worth keying in when a production
/// module exists to consume them — until then they would be typing with no
/// reader.
model StockBatch {
  id String @id @default(cuid())

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  /// The supplier's batch or lot number, or one the office invents. Unique per
  /// material so two deliveries cannot be confused, but repeatable across
  /// materials because suppliers number their own lots.
  batchCode String @map("batch_code")

  /// Free text — 'Warehouse A', 'A-01'. Not a managed list: the works has one
  /// building, and a location table nobody maintains is worse than a field
  /// somebody types.
  location String @default("NA")

  receivedOn DateTime @map("received_on") @db.Date

  /// What arrived, in the material's own unit. Kept alongside `quantity` so a
  /// batch can still say how much of it has gone.
  initialQuantity Decimal @map("initial_quantity") @db.Decimal(14, 3)

  /**
   * What the delivery note said, before conversion.
   * Film is bought by the tonne and stocked by the kilogram. `initialQuantity`
   * holds the kilograms because that is what everything downstream measures in;
   * these two hold the 2 and the TON, so the batch can still be checked against
   * the paperwork it came with. Null when the two units were the same, which is
   * most deliveries.
   */
  purchaseQuantity Decimal? @map("purchase_quantity") @db.Decimal(14, 3)
  purchaseUnit     String?  @map("purchase_unit")

  /**
   * What is left, in the material's own unit.
   * Cached from the ledger and written in the same transaction as every
   * movement, so the two cannot drift. Kept rather than summed on read because
   * every screen wants it and a sum per batch per page is a lot of arithmetic
   * for a number that changes a few times a day.
   */
  quantity Decimal @db.Decimal(14, 3)

  /**
   * **The reel this batch is, where the material comes on reels.**
   * A film is not fungible by weight. The works' own stock register is kept by
   * width for exactly this reason: PET 12µm sits in twenty-three widths from
   * 340 mm to 1040 mm, and a job that needs 650 mm cannot be run on a 340 mm
   * reel however many kilograms of it there are.
   * Null for anything not bought as a reel — ink, adhesive, solvent — and for a
   * film delivery nobody recorded the width of.
   */
  widthMm Decimal? @map("width_mm") @db.Decimal(10, 2)

  /**
   * The gauge of this particular delivery.
   * On the material as well, in its name, but the works prices a film by TYPE
   * and buys it in many gauges — their register carries LDPE in fourteen of
   * them under one rate. So the gauge belongs to the delivery, not to the
   * catalogue row.
   */
  micron Decimal? @db.Decimal(10, 2)

  /// Job cards holding some of this roll. See StockReservation.
  reservations StockReservation[]

  /**
   * Rupees per unit actually paid for this delivery.
   * Null when nobody recorded it, in which case the material's current rate
   * stands in for valuation. Stored per batch because that is what the stock is
   * worth — today's rate values what it would cost to replace, which is a
   * different question and not the one a stock sheet answers.
   */
  ratePerUnit Decimal? @map("rate_per_unit") @db.Decimal(12, 4)

  /// Supplier, invoice or delivery note. Free text.
  reference String @default("")
  notes     String @default("")

  movements       StockMovement[]
  /// The delivery this batch came from, when it came from an order rather than
  /// being received by hand.
  purchaseReceipt PurchaseReceipt?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([materialId, batchCode])
  @@index([materialId, receivedOn])
  @@map("stock_batches")
}

/// One change to a batch's quantity, or to where it sits.
///
/// Immutable. Nothing edits or deletes one of these — the running balance on
/// every later row would be wrong, and a stock ledger that can be rewritten
/// answers nothing. Corrections are ADJUSTMENT rows.
model StockMovement {
  id String @id @default(cuid())

  batchId String     @map("batch_id")
  batch   StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Denormalised from the batch, which never changes material. Lets the whole
  /// of one material's history be read without a join, and lets consumption be
  /// totalled per material without walking every batch.
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  kind StockMovementKind

  /**
   * Signed, in the material's unit: positive added, negative taken away.
   * Zero on a TRANSFER, which moves stock without changing how much there is.
   */
  quantity Decimal @db.Decimal(14, 3)

  /// The material's total across every batch, immediately after this movement.
  /// Stored so the history reads without a window function, and so a balance
  /// printed last month still says what the books said last month.
  balanceAfter Decimal @map("balance_after") @db.Decimal(14, 3)

  /// What it was issued for. Only meaningful on an ISSUE or WASTE, and nullable
  /// so retiring a job leaves the movement readable.
  jobId String? @map("job_id")
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Where it went and came from. Only set on a TRANSFER.
  fromLocation String @default("") @map("from_location")
  toLocation   String @default("") @map("to_location")

  /// Delivery note, PO number, cycle-count sheet — whatever names this event.
  reference String @default("")
  notes     String @default("")

  /// Display name of whoever recorded it, matching `entered_by` on rates.
  enteredBy String @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([materialId, createdAt])
  @@index([batchId, createdAt])
  @@index([jobId])
  @@map("stock_movements")
}

/// Where a purchase order is in its life.
///
/// Three of these are decisions somebody makes — the order was placed, it is on
/// the road, it was cancelled. Two are **facts about what has arrived**, and are
/// set by recording a receipt rather than by choosing them: an order nobody has
/// remembered to mark as received is exactly the order somebody is chasing.
///
/// Delay is deliberately absent. It is a fact about today's date against the
/// expected one, so it is computed rather than stored — a stored flag needs a
/// nightly job or a human, and is wrong in between.
enum PurchaseOrderStatus {
  ORDERED
  IN_TRANSIT
  /// Some of the order has arrived. Set by the service, never chosen.
  PARTIALLY_RECEIVED
  /// Every line is settled — accepted, rejected, or short-closed.
  RECEIVED
  CANCELLED
}

/// Who the works buys from.
///
/// What they supply and what they last charged are **not** stored here. Both
/// are answered by the orders placed with them, and a second copy would be a
/// list somebody has to keep up to date and nobody would.
model Supplier {
  id String @id @default(cuid())

  name          String @unique
  contactPerson String @default("NA") @map("contact_person")
  mobile        String @default("NA")
  email         String @default("NA")
  address       String @default("NA")
  /// GSTIN. 'NA' where unknown, matching customers.
  gstNumber     String @default("NA") @map("gst_number")
  notes         String @default("")

  /// Retired suppliers stay for the sake of old orders but leave the form.
  isActive Boolean @default(true) @map("is_active")

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("suppliers")
}

/// One order placed with one supplier.
model PurchaseOrder {
  id String @id @default(cuid())

  /// Sequential and human-facing, shown as PO-4488. Unique, unlike a quotation
  /// number — an order is never revised into a second version.
  number Int @unique

  supplierId String   @map("supplier_id")
  /// Restricted rather than nullable: an order with no supplier cannot be
  /// chased, and a supplier with orders against them should be retired, not
  /// deleted.
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status PurchaseOrderStatus @default(ORDERED)

  orderedOn  DateTime  @map("ordered_on") @db.Date
  /// When it was promised. Null when the supplier would not say; a line with no
  /// expected date can never be late, which is honest — nothing was promised.
  expectedOn DateTime? @map("expected_on") @db.Date

  notes String @default("")

  /// Display name of whoever raised it, matching `entered_by` on rates.
  raisedBy String @map("raised_by")

  lines    PurchaseOrderLine[]
  receipts PurchaseReceipt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, orderedOn])
  @@index([supplierId])
  @@map("purchase_orders")
}

/// One material on one order.
model PurchaseOrderLine {
  id String @id @default(cuid())

  orderId String        @map("order_id")
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  position Int

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  /// What was ordered, in the unit it was ordered in — film is bought by the
  /// tonne. Receipts are entered in the same unit and converted to the
  /// material's stocked unit on the way into inventory.
  quantity Decimal @db.Decimal(14, 3)
  unit     String

  /// Rupees per `unit`, as agreed with the supplier.
  ratePerUnit Decimal @map("rate_per_unit") @db.Decimal(12, 4)

  /**
   * Closed short, with what happened written down.
   * A supplier who sends 380 of 400 and will not send the rest leaves a line
   * that is neither open nor complete. Without this it stays on the pending
   * list forever and the office learns to ignore that list.
   */
  closedAt     DateTime? @map("closed_at")
  closedReason String    @default("") @map("closed_reason")

  receipts PurchaseReceipt[]

  @@unique([orderId, position])
  @@index([materialId])
  @@map("purchase_order_lines")
}

/// One delivery against one line, and what became of it.
///
/// The join between buying and holding: the accepted quantity opens a stock
/// batch through the same path a manual receipt uses, so there is one way stock
/// comes into existence and one ledger recording it. `batchId` is that batch.
///
/// Rejected material is recorded and **never reaches stock**. Faulty goods are
/// not inventory, and counting them would overstate what the works can actually
/// print with.
model PurchaseReceipt {
  id String @id @default(cuid())

  lineId String            @map("line_id")
  line   PurchaseOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  /// Denormalised from the line, which never changes order. Lets an order's
  /// deliveries be read without walking its lines.
  orderId String        @map("order_id")
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  receivedOn DateTime @map("received_on") @db.Date

  /// In the line's own unit, both of them.
  acceptedQuantity Decimal @map("accepted_quantity") @db.Decimal(14, 3)
  rejectedQuantity Decimal @default(0) @map("rejected_quantity") @db.Decimal(14, 3)
  /// Required whenever anything was rejected — a rejection nobody explained is
  /// one nobody can take up with the supplier.
  rejectionReason  String  @default("") @map("rejection_reason")

  /**
   * The stock this delivery became.
   * Null when everything was rejected, which is the one case a delivery creates
   * no stock. Nullable rather than absent so the receipt still records that a
   * lorry came and what was wrong with it.
   */
  batchId String?     @unique @map("batch_id")
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  notes     String @default("")
  enteredBy String @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, receivedOn])
  @@index([lineId])
  @@map("purchase_receipts")
}

/// Who paid for a cylinder, and therefore who it belongs to.
///
/// The distinction the office actually needs: a customer-owned set goes back if
/// they leave, and cannot be scrapped without asking. Yuva-owned is an asset on
/// the books.
enum CylinderOwnership {
  CUSTOMER_OWNED
  YUVA_OWNED
}

/// Where a cylinder is in its life.
///
/// Set by recording an event, never chosen directly — a cylinder somebody
/// forgot to mark as returned is exactly the one nobody can find. See
/// `statusAfter` in `@yuva/shared`.
enum CylinderStatus {
  /// On the shelf, ready to mount.
  IN_STORE
  /// Reserved for a run but not yet on the machine.
  ALLOCATED
  /// Mounted and printing.
  IN_USE
  /// Off the machine and unusable until reworked.
  DAMAGED
  /// Usable but due for re-engraving before its next run.
  NEEDS_REWORK
  /// Scrapped or returned to the customer. Kept for the history.
  RETIRED
}

/// What happened to a cylinder.
///
/// A ledger, like stock movements: the events are the truth and `status` is a
/// cache of the latest one. Nothing edits or deletes an event — "who had it
/// last and when" is the whole point, and a history that can be rewritten
/// answers nothing.
enum CylinderEventKind {
  /// Cut, and on the shelf for the first time.
  ENGRAVED
  /// Reserved for a run.
  ALLOCATED
  /// Mounted and printing.
  IN_USE
  /// Back on the shelf, cleaned.
  RETURNED
  /// Found unusable.
  DAMAGED
  /// Re-engraved and usable again.
  REWORKED
  /// Moved shelves. Changes where it is, not what it is doing.
  TRANSFERRED
  /// Scrapped, or gone back to the customer.
  RETIRED
}

/// One engraved cylinder.
///
/// **A design is a job.** The 420 jobs already on record are the design
/// register — customer, product, colours, diameter and count all live there and
/// the quotation wizard already treats a saved job as the design it charges
/// cylinders for. This model adds the thing that was missing: the individual
/// cylinders, each identifiable, so "where is the cyan one for Krishna Dairy"
/// has an answer. That question is what stops a set being re-engraved because
/// nobody could find the old one.
model Cylinder {
  id String @id @default(cuid())

  /// The works' own number, as painted on the cylinder. Unique across the
  /// works — two cylinders sharing one cannot be told apart on a shelf.
  code String @unique

  /// The design it prints. Restricted rather than nullable: a cylinder with no
  /// design is one nobody can identify the purpose of, and a job with cylinders
  /// against it should not be deleted.
  jobId String @map("job_id")
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  /// Which separation it carries — Cyan, White, a spot colour. Free text,
  /// because a spot colour is named by whatever the customer calls it.
  colour   String @default("NA")
  /// Print station order, where the works records it.
  position Int?

  ownership CylinderOwnership @default(YUVA_OWNED)
  status    CylinderStatus    @default(IN_STORE)

  /// Free text, like a stock location. 'Cylinder Store A-1'.
  location String @default("NA")

  /// The engraved geometry. Held here as well as on the job because a
  /// replacement cylinder is sometimes cut to a different repeat, and the job
  /// records what was designed rather than what is on the shelf.
  diameterMm      Decimal? @map("diameter_mm") @db.Decimal(10, 2)
  circumferenceMm Decimal? @map("circumference_mm") @db.Decimal(10, 2)

  /// What this one cost to engrave. Per cylinder, so a set's cost is the sum
  /// and a single replacement does not have to be apportioned by hand.
  cost Decimal? @db.Decimal(12, 2)

  /// Who cut it, and when it came in.
  engraver   String    @default("NA")
  engravedOn DateTime? @map("engraved_on") @db.Date

  notes String @default("")

  events CylinderEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobId])
  @@index([status])
  @@map("cylinders")
}

/// One thing that happened to one cylinder. Immutable.
model CylinderEvent {
  id String @id @default(cuid())

  cylinderId String   @map("cylinder_id")
  cylinder   Cylinder @relation(fields: [cylinderId], references: [id], onDelete: Cascade)

  kind       CylinderEventKind
  occurredOn DateTime          @map("occurred_on") @db.Date

  /// The status this event left the cylinder in, stored so the history reads
  /// without replaying it, and so a line printed last month still says what the
  /// books said last month.
  statusAfter CylinderStatus @map("status_after")

  /**
   * What it was for — a job number, a works order, a delivery note.
   * Free text on purpose. The wireframe shows "#1024", which is a production
   * order, and there is no production module yet; a foreign key to something
   * that does not exist would be worse than a string somebody can read.
   */
  reference String @default("")

  /// Where it went, on a TRANSFERRED event.
  fromLocation String @default("") @map("from_location")
  toLocation   String @default("") @map("to_location")

  notes     String @default("")
  enteredBy String @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([cylinderId, occurredOn])
  @@map("cylinder_events")
}

/// What a design file is.
enum ArtworkKind {
  /// The file the cylinders are engraved from.
  ARTWORK
  /// A colour proof, or a print that was approved.
  PROOF
  /// A photo of the pouch, an older sample, a customer's sketch.
  REFERENCE
  OTHER
}

/// Where a design file is in its life.
enum ArtworkStatus {
  /// A signed upload that has not been confirmed. See the JobArtwork model.
  PENDING
  ACTIVE
  /// Replaced by a later revision, and kept.
  SUPERSEDED
  /// Taken off the design screen. The object stays in the bucket.
  REMOVED
  /// The file itself has been erased from the bucket. The row stays — see the
  /// JobArtwork model.
  DELETED
}

/// A design file, held in Cloudflare R2 with only its description here.
///
/// **A design is a job**, as it is for cylinders, so artwork hangs off the job
/// and the customer is reached through it. Filing artwork against a customer
/// would put four designs' files in one drawer with nothing to tell them apart.
///
/// Files are never replaced in place. The cylinder on the shelf was engraved
/// from one version of one file, and a store that overwrites cannot say which,
/// so a revision supersedes its predecessor and both stay.
///
/// A file can be erased outright — a wrong upload should not sit in a bucket
/// forever — but the ROW never goes. The bytes and the record answer different
/// questions: the bytes are what the engraver needs, and the record is what
/// the office needs when it asks where the artwork went.
///
/// PENDING is the first state because the browser puts the bytes into R2
/// itself — the API signs a URL and never touches the file. The row is written
/// before the upload, so an object that arrives already belongs to something
/// and nobody can confirm a key this server did not issue.
model JobArtwork {
  id String @id @default(cuid())

  jobId String @map("job_id")
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  kind   ArtworkKind   @default(ARTWORK)
  status ArtworkStatus @default(PENDING)

  /// The object key in the bucket. Unique: two rows pointing at one object
  /// means removing either loses the other's file.
  ///
  /// Null once the file has been erased. Nulled deliberately rather than left
  /// dangling: a key that cannot be read is a key nothing can accidentally
  /// sign a URL for, and Postgres does not treat nulls as colliding on a
  /// unique index. Where it *was* is of no use once the object is gone.
  storageKey String? @unique @map("storage_key")

  /// What the designer called it. Kept for display and for the download name;
  /// the key is a sanitised form of it and is not shown.
  filename    String
  contentType String @map("content_type")
  /// What R2 reports the object to be, read back at confirmation rather than
  /// taken from the browser, which is free to claim anything.
  sizeBytes   Int    @default(0) @map("size_bytes")

  /// Which revision this is. A replacement carries its predecessor's plus one.
  version Int @default(1)

  /// The file this one replaced, and the one that replaced it. Restricted, so
  /// the chain cannot be broken from the middle.
  replacesId String?     @unique @map("replaces_id")
  replaces   JobArtwork? @relation("ArtworkRevisions", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy JobArtwork? @relation("ArtworkRevisions")

  notes String @default("")

  uploadedBy String    @map("uploaded_by")
  /// When the object was confirmed present. Null while PENDING.
  uploadedAt DateTime? @map("uploaded_at")

  /// Who erased the file, and when. Set only on DELETED.
  ///
  /// This is the whole reason the row outlives the bytes. "There were three
  /// files and now there are two" is not something anybody can act on; the
  /// office asks where the artwork went, and a name and a date is an answer.
  deletedBy String?   @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobId, status])
  @@map("job_artwork")
}

/// A machine, or a stage that behaves like one.
enum MachineKind {
  PRINTING
  LAMINATION
  SLITTING
  POUCHING
}

/// A machine on the floor, and what a minute of it costs.
///
/// Costing master data: this is what the works IS, not what a job is. A rate
/// is built by turning kilograms into running metres, metres into minutes at
/// the machine's speed, and minutes into rupees.
model CostingMachine {
  id String @id @default(cuid())

  name String      @unique
  kind MachineKind

  /// Orders booked onto it. What the machine has coming, which is the other
  /// half of a planning board.
  plannedOrders Order[]

  /// Connected load. Power is costed as horsepower × a rate per hour.
  ///
  /// On a press with `stationHorsepower` this is the MAIN DRIVE alone — what it
  /// draws with nothing but the first colour on — and the stations are added to
  /// it. On every other machine it is the whole load.
  horsepower Decimal @db.Decimal(10, 2)

  /// What one printing station adds to the load when its colour is inked.
  ///
  /// Zero means a fixed load, which is what a laminator or a slitter has. The
  /// works' press is a 30 HP drive with three 12 HP station motors, and their
  /// sheet switches those on as colours are added — so a two-colour job draws
  /// 30 HP and a seven-colour job draws 66. Charging the full connected load on
  /// every job overstated electricity on anything short of a full press.
  stationHorsepower Decimal @default(0) @map("station_horsepower") @db.Decimal(10, 2)

  /// Which colour switches each station motor on, as "3,4,6".
  ///
  /// The 3rd, 4th and 6th, read off the works' sheet and confirmed by the
  /// operator. The layout of that sheet implies the 3rd, 5th and 7th and two of
  /// its four references are off by one, so the readings differ at four colours
  /// and at six — the press runs to the formulas as written. Editable because a
  /// rewired press is a fact about the works, not about this code.
  stationColourSteps String @default("") @map("station_colour_steps")

  /**
   * Rupees per horsepower-hour.
   * Per machine rather than one figure for the works, because that is what the
   * client's sheets do: printing is costed at the electricity tariff itself
   * (Rs 9) while lamination and slitting carry Rs 35 and Rs 60, which are
   * plainly loaded with more than power. One rate for all three would silently
   * reprice two machines.
   */
  powerRatePerHpHour Decimal @map("power_rate_per_hp_hour") @db.Decimal(10, 2)

  /// Metres a minute.
  speedMPerMin Decimal @map("speed_m_per_min") @db.Decimal(10, 2)
  /// Setting and cleaning, before a metre is run.
  setupMinutes Int     @default(0) @map("setup_minutes")

  /**
   * Share of the connected load the machine draws while it is being set, 0-1.
   * The client's sheet charges nothing for setup power, which cannot be right
   * — the press is switched on. Charging the full load is not right either: a
   * press being threaded and having its cylinders cleaned is not running at
   * 66 HP. Neither figure is knowable from here, so it is the works' to set —
   * and 0 is the default because it is what their sheet does, which is what a
   * quoted rate has to tie out against.
   */
  setupPowerFactor Decimal @default(0) @map("setup_power_factor") @db.Decimal(4, 3)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Stages of a job card run on it.
  productionStages ProductionStage[]
  /// **The one of its kind the works actually runs.**
  ///
  /// The costing charges one machine per process, and without this it charged
  /// whichever came first on the list — which is how a works with an old
  /// laminator and a new one priced every job on the old one's speed.
  ///
  /// At most one per kind, enforced in the service. None marked keeps the old
  /// behaviour, so nothing already quoted moves until somebody says which.
  isDefault        Boolean           @default(false) @map("is_default")

  @@map("costing_machines")
}

/// A wage, and which machine's minutes it is paid for.
///
/// Salaries are monthly; the working month in settings turns them into a rate
/// per minute. Somebody is paid for the setup time as well as the run time,
/// which is why the setup minutes live on the machine.
/**
 * What a process is crewed at, and from when.
 * **Dated, like every other costing figure**, and it was the last one that was
 * not. A single live row with an on/off switch reached backwards: switching the
 * lamination crew on in 2026 re-priced seven quotations written in 2022, each
 * by about a rupee a kilogram, because a quotation is costed against whatever
 * the master says now. The half-open window is what stops that — see
 * `costing-window.ts`.
 * The role name is **not unique**, for the same reason an overhead's is not:
 * "Lamination Operator" at Rs 18,000 until March and Rs 20,000 after it is the
 * same job twice, and both windows have to survive or the March quotations stop
 * explaining themselves.
 * There is no `isActive` column either. Whether a row is live is a question
 * about a date, and holding the answer in a second place is how the two come to
 * disagree — the API derives it from `effectiveTo`.
 */
model CostingLabour {
  id String @id @default(cuid())

  role    String
  process MachineKind

  monthlySalary Decimal @map("monthly_salary") @db.Decimal(12, 2)

  /// The first day this wage applies.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// The first day it does NOT. Null while it is still live.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  sortOrder Int @default(0) @map("sort_order")

  /// The people paid as this. Restricted rather than cascaded: a role with
  /// somebody on it is a role the works still has, and deleting it out from
  /// under them would leave a person nothing describes.
  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("costing_labour")
}

/// When somebody is normally in.
enum Shift {
  MORNING
  AFTERNOON
  NIGHT
  /// Office hours — the people who are not on a shift rota at all.
  GENERAL
}

/**
 * One of the works' people.
 * **Deliberately not a personnel system.** No attendance, no leave calendar, no
 * payroll: a works of forty does not run those off a screen, and a screen that
 * asks for them is filled in once and then abandoned. What this holds is the
 * handful of facts the rest of the system needs so that a person stops being
 * typed by hand — which is how fourteen job sheets came to hold "Printing
 * operattor 2", "Operator 1" and "office 1" as though they were three roles.
 * **No wage here.** It lives on the costing role this points at, dated, where
 * the costing already reads it, so a rise is typed once rather than onto forty
 * records. `roleName` carries free text for the office and the warehouse, whom
 * no costing role describes.
 * What somebody is DOING is not here either. That is the one job card stage
 * running with their name on it, and it is worked out on the way out.
 */
model Employee {
  id String @id @default(cuid())

  name String
  /// A short code, where the works uses one.
  code String @default("")

  roleId   String?        @map("role_id")
  role     CostingLabour? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// The role's name, or free text where there is no role. Never blank.
  roleName String         @map("role_name")

  shift Shift @default(GENERAL)

  phone    String    @default("")
  joinedOn DateTime? @map("joined_on") @db.Date

  /// Cleared when somebody leaves. The record stays — their runs name them.
  isActive Boolean @default(true) @map("is_active")

  notes String @default("")

  /// Every stage they have run. See ProductionStage.operatorId.
  stages ProductionStage[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  /// Stoppages and issues they recorded at the machine.
  floorEvents   FloorEvent[]
  /// Quality issues they are answerable for.
  qualityIssues QualityIssue[]

  @@index([isActive, name])
  @@index([roleId])
  @@map("employees")
}

/// How a works-defined overhead is applied to a job.
///
/// The engine cannot guess: "Maintenance 5000" is three orders of magnitude
/// apart read per job and read per kilogram. So the basis travels with the
/// figure and the costing reads it.
enum OverheadBasis {
  PER_KG
  PER_JOB
  PER_POUCH
  PER_DAY
  PERCENT_MATERIAL
  PERCENT_TOTAL
}

/// An overhead the works added for itself.
///
/// Every other figure a rate is built from is wired into the costing by name.
/// These are not, which is the point — a works that starts paying for something
/// new should not need a migration to say so.
///
/// **Dated rather than deleted.** A row applies to a quotation whose date falls
/// on or after `effectiveFrom` and before `effectiveTo`, so adding one today
/// cannot move a quotation written last year, and ending one leaves the
/// document it priced still explicable. Changing the amount or the basis closes
/// the row and opens a new one, the same way a material rate keeps its history.
///
/// The name is NOT unique: "Maintenance" at Rs 500 until March and Rs 700 after
/// it is the same charge twice, which is exactly what the history is for.
model CostingOverhead {
  id String @id @default(cuid())

  name   String
  basis  OverheadBasis
  amount Decimal       @db.Decimal(12, 4)

  /// The first day this figure applies.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// The first day it does NOT. Null while it is still live.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("costing_overheads")
}

/// Where a customer order has got to.
///
/// Four, and no more, because a status nobody can honestly move it out of is
/// worse than no status at all. The wireframe's "Pending Materials" and
/// "Awaiting QC" describe gates that Planning and Quality will own; they belong
/// here the day those exist, and not before.
enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

/// What a customer has actually committed to.
///
/// The missing link between a quotation and what the works then made. A won
/// quotation said what the price would be; a job sheet says what the run cost
/// once it was over. Neither records that a customer asked for 500 kg by the
/// fifth, against their purchase order number, and where that has got to.
///
/// **One order per quotation LINE, not per quotation.** A quotation carries
/// several jobs and they are made, finished and delivered separately — one
/// order holding all of them could never say that two are done and one is late.
///
/// `quotationItemId` is unique, which is what makes winning idempotent: the
/// second time a quotation is won it creates nothing, exactly as its jobs do.
model Order {
  id     String      @id @default(cuid())
  /// Sequential and human-facing, like a quotation's. Its own series.
  number Int         @unique
  status OrderStatus @default(CONFIRMED)

  customerId   String?   @map("customer_id")
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Snapshot, so an order still reads if the customer record is renamed.
  customerName String    @map("customer_name")

  jobId   String? @map("job_id")
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobName String  @map("job_name")

  /// Where it came from. Null on one the office typed for repeat business.
  quotationId     String?        @map("quotation_id")
  quotation       Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  quotationItemId String?        @unique @map("quotation_item_id")
  quotationItem   QuotationItem? @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)

  /// What was agreed. Both units, as a quotation line carries both.
  quantityKg      Decimal @map("quantity_kg") @db.Decimal(12, 3)
  ratePerKg       Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  quantityPouches Int     @default(0) @map("quantity_pouches")
  ratePerPouch    Decimal @default(0) @map("rate_per_pouch") @db.Decimal(12, 4)
  /// Stored rather than multiplied on read, so a saved order cannot drift.
  amount          Decimal @db.Decimal(14, 2)

  /// The customer's own reference. What they will quote back on the phone.
  customerPoNumber String    @default("") @map("customer_po_number")
  orderDate        DateTime  @map("order_date") @db.Date
  dueDate          DateTime? @map("due_date") @db.Date

  notes String @default("")

  /// The job cards raised against it. Usually one; several when a big order
  /// is run in batches, which is why this is not a one-to-one.
  productionOrders ProductionOrder[]

  /// What has actually gone out against it — which is what completes it.
  /// Restricted rather than cascaded: an order with a delivery behind it is
  /// not deletable, because the challan would outlive what it was raised for.
  dispatchLines DispatchLine[]

  /// **When the works means to start it, and on what machine.**
  ///
  /// The one fact planning stores, and the only thing in the system that ever
  /// held it. An order carries a due date, which is the customer's; a job card
  /// carries stages, which are the floor's; and nothing said which press a job
  /// was booked onto next Tuesday.
  ///
  /// Everything else the planning board shows — whether the film is there, how
  /// long it will take, whether it can still make its date — is worked out from
  /// facts that already exist. A board whose figures need maintaining is a
  /// board nobody believes by Wednesday.
  plannedStart     DateTime?       @map("planned_start") @db.Date
  /// The machine it starts on. For a printed job that is the press, which is
  /// the booking that matters — the later stages follow it down the floor.
  plannedMachineId String?         @map("planned_machine_id")
  plannedMachine   CostingMachine? @relation(fields: [plannedMachineId], references: [id], onDelete: SetNull)
  /// Why it sits where it does in the queue. "Customer collecting Friday" is
  /// the kind of thing that explains a plan nobody else would have made.
  planNote         String          @default("") @map("plan_note")
  plannedBy        String          @default("") @map("planned_by")
  plannedAt        DateTime?       @map("planned_at")

  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  /// Why it was cancelled. "We lost it" teaches nothing; the reason does.
  cancelledReason String    @default("") @map("cancelled_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([customerId])
  @@index([dueDate])
  @@index([plannedStart])
  @@map("orders")
}

/// Where a job card as a whole has got to.
///
/// "Delayed" is deliberately not here — it is the order's due date compared
/// with today, not a state anybody sets. A status somebody has to remember to
/// change is a status that is wrong most of the time.
enum ProductionStatus {
  PLANNED
  RUNNING
  ON_HOLD
  COMPLETED
}

/// Where one stage of a job card has got to.
enum ProductionStageStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
}

/// A job card — the run itself, against the order it is making.
///
/// The link the works has been missing: a quotation says what a job should
/// cost, an order says what was asked for, and this says what the floor
/// actually did about it — on which machine, by whom, and what it lost at each
/// stage.
///
/// **Not unique per order.** Usually one card answers one order, but a large
/// order genuinely runs in batches, and a unique constraint would be a
/// migration the first time that happened. The service refuses a second card
/// while one is still open, which is the rule that actually wanted enforcing.
model ProductionOrder {
  id     String           @id @default(cuid())
  /// Sequential and human-facing. Its own series, like an order's.
  number Int              @unique
  status ProductionStatus @default(PLANNED)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Snapshots, so a card still reads if the design is renamed.
  customerName String @map("customer_name")
  jobName      String @map("job_name")

  jobId String? @map("job_id")
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// What this card is making. Usually the whole order; less when it is one
  /// batch of it.
  quantityKg Decimal @map("quantity_kg") @db.Decimal(12, 3)

  notes String @default("")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Why the works ran it anyway, when the material was short.
  ///
  /// A shortage stops a stage starting. It must not stop it for good: material
  /// is often physically in the building before anybody books it in, and a
  /// system that refuses to let the floor run a job already on the machine is
  /// one they work around — after which the data stops being true. So the block
  /// is real and getting past it is deliberate, named and dated.
  materialOverrideReason String    @default("") @map("material_override_reason")
  materialOverrideBy     String    @default("") @map("material_override_by")
  materialOverrideAt     DateTime? @map("material_override_at")

  stages        ProductionStage[]
  reservations  StockReservation[]
  /// What this run cost, once the office has worked it out. See JobSheet.
  jobSheet      JobSheet?
  /// The deliveries the godown took out of this run.
  dispatchLines DispatchLine[]
  /// What the floor said about it — stopped, and why.
  floorEvents   FloorEvent[]
  /// What was found wrong with it.
  qualityIssues QualityIssue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([orderId])
  @@map("production_orders")
}

/// One process a job card passes through.
///
/// Derived from the structure when the card is raised — printing unless the job
/// prints nothing, one lamination row **per bond**, slitting always, pouch
/// making only where pouches are made — and then the office's to correct. A
/// stage that does not apply is SKIPPED rather than deleted, so the card still
/// says what the job did not need instead of leaving a gap.
///
/// Each lamination pass is its own row because it is its own run: its own
/// machine, its own operator and its own waste. The works' job sheet names them
/// Lamination 1 and Lamination 2 for the same reason.
model ProductionStage {
  id String @id @default(cuid())

  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  /// 1-based, the order the job meets them in.
  position Int
  stage    MachineKind
  /// Which lamination pass, 1 or 2. Zero on every other stage.
  pass     Int                   @default(0)
  status   ProductionStageStatus @default(PENDING)

  machineId   String?         @map("machine_id")
  machine     CostingMachine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  /// Snapshot, so a finished card still says which machine ran it.
  machineName String          @default("") @map("machine_name")

  /// Who ran it.
  ///
  /// The same shape as the machine above it: a link, and a snapshot of the name
  /// beside it. The snapshot is what makes a finished card still readable — it
  /// survives the person leaving, the record being renamed, and the fourteen
  /// imported sheets that name somebody this works never registered.
  operatorId  String?   @map("operator_id")
  operatorRef Employee? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  operator    String    @default("")

  /// Weighed, both of them. What it lost is the difference and is never stored
  /// — a third figure that can disagree with the two it comes from is a figure
  /// nobody can trust.
  inputKg  Decimal @default(0) @map("input_kg") @db.Decimal(12, 3)
  outputKg Decimal @default(0) @map("output_kg") @db.Decimal(12, 3)

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  notes String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  floorEvents   FloorEvent[]
  qualityIssues QualityIssue[]

  @@unique([productionOrderId, position])
  @@index([status])
  /// What a given operator has run. The employee screen asks exactly this.
  @@index([operatorId])
  @@map("production_stages")
}

/// Whether a reservation is still holding stock back.
enum ReservationStatus {
  /// Committed to a job card that has not finished.
  HELD
  /// Let go — the card finished, or was cancelled.
  RELEASED
}

/// Material committed to a job card, but not yet taken off the shelf.
///
/// **A reservation is not a movement.** It never touches a batch and never
/// appears in the ledger — it only makes stock read as *committed* rather than
/// *free*. That is the whole design, and it is what guarantees nothing is
/// deducted twice: the job sheet remains the only thing that issues material,
/// because the job sheet is the only thing that knows what was actually
/// weighed. Production knows what a job SHOULD take, which is a different and
/// earlier question.
///
/// So the arithmetic everywhere is:
///
///     free = what is on hand − what is held against unfinished cards
///
/// and a shortage is measured against `free`, never against the ledger.
model StockReservation {
  id String @id @default(cuid())

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  /**
   * **The roll this claim is on.**
   * A claim on "781 kg of LDPE" is a claim on nothing in particular: it cannot
   * tell the floor which rolls to fetch, it cannot stop two cards being
   * promised one roll, and it forced the availability sum to GUESS which reels
   * a claim had come off. Naming the roll removes the guess — what is left of
   * a roll is what is on it less what other cards hold of that roll.
   * Null only on rows written before reels were named. Nothing writes one now.
   * Cascades: a claim against a roll that no longer exists is not a claim.
   */
  batchId String?     @map("batch_id")
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// In the material's own unit, as the batches are.
  quantity Decimal           @db.Decimal(14, 3)
  status   ReservationStatus @default(HELD)

  releasedAt DateTime? @map("released_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per material per card: raising a card twice for the same film
  /// should correct the figure, not hold it twice.
  /**
   * /**
   * /**
   * /**
   * /**
   * /* One row per card per ROLL. A job spanning three rolls holds three of them,
   * which is the point — the old key allowed one row per material.
   */
  @@unique([productionOrderId, batchId])
  @@index([materialId, status])
  @@index([batchId, status])
  @@map("stock_reservations")
}

/// Whether an ink is one of the four every press carries, or a job's own.
enum InkKind {
  PROCESS
  SPECIAL
}

// ---------------------------------------------------------------------------
// Job sheets — what a run actually cost
// ---------------------------------------------------------------------------

/// Where a job sheet is in its life.
///
/// A sheet is OPEN for as long as the job is on the floor and figures are still
/// coming in, which is most of a day. COSTED means the office has settled it
/// and the cost per kilogram is the works' answer. CLOSED means the material it
/// consumed has been taken off stock — the one irreversible step, and the
/// reason it is a status rather than a flag on the same row.
enum JobSheetStatus {
  OPEN
  COSTED
  CLOSED
}

/// The five processes a day's electricity is shared out between.
enum JobSheetStage {
  PRINTING
  LAMINATION_1
  LAMINATION_2
  SLITTING
  POUCHING
}

/// Which half of the works a consumable was drawn for.
enum JobSheetSection {
  PRINTING
  LAMINATION
}

/// What kind of thing a line is, so a sheet can be laid out without guessing
/// from the name.
enum JobSheetLineKind {
  FILM
  SOLVENT
  INK
  ADHESIVE
  OTHER
}

/// One production run, and what it actually cost.
///
/// The works' September 2026 Job Sheet, which is a different document from a
/// quotation and answers a different question. A quotation estimates a price
/// from a design; this costs a run from what was issued to the floor and what
/// came back. The office keeps both, because the gap between them is the only
/// place an estimate is ever caught being wrong.
///
/// Every overhead rate is **stored on the sheet** rather than read from
/// settings when it is displayed. A sheet is a record of what the works decided
/// that week — electricity was Rs 4,000 a day in March and Rs 6,000 in
/// September, on the works' own tabs — and a record that reprices itself when a
/// setting changes is not a record.
model JobSheet {
  id String @id @default(cuid())

  /// Sequential and human-facing: the "Sr. No." at the top of the paper sheet.
  number Int @unique

  /// The day the job ran, not the day the sheet was keyed in.
  date DateTime @db.Date

  status JobSheetStatus @default(OPEN)

  /// The design. Nullable so retiring a job leaves its history readable, and
  /// the name is snapshotted beside it for the same reason.
  jobId   String? @map("job_id")
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobName String  @default("") @map("job_name")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /**
   * The job card this sheet is the costing of.
   * One run, one costing — hence unique. Two sheets against one card would each
   * claim to be what that run cost, and nothing could say which was right.
   * Nullable, because the works' own imported sheets predate job cards entirely
   * and an office keying yesterday's paper has no card to point at. But where
   * it IS set it closes a real gap: posting the sheet is the moment the run's
   * material genuinely leaves the shelf, so it is the moment the card's claim
   * on that material should stop counting. See material-reservation.ts.
   */
  productionOrderId String?          @unique @map("production_order_id")
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  operatorName String @default("") @map("operator_name")

  // ---- The header of the paper sheet ---------------------------------------
  filmType        String   @default("") @map("film_type")
  webWidthMm      Decimal? @map("web_width_mm") @db.Decimal(10, 2)
  micron          Decimal? @db.Decimal(10, 3)
  circumferenceMm Decimal? @map("circumference_mm") @db.Decimal(10, 2)
  cylinderCount   Int      @default(0) @map("cylinder_count")

  /**
   * The mixed drums, pooled across the stage.
   * Nothing goes to the press as bought: a colour is mixed 40% pigment, 40%
   * ethyl acetate and 20% toluene, and the sheet books each drum back to its
   * ingredients. An ink line carries its own mix; the solvents draw from the
   * pooled total, which is what these two hold. Lamination works the same way
   * with adhesive, hardener and ethyl.
   */
  printMixIssuedKg   Decimal @default(0) @map("print_mix_issued_kg") @db.Decimal(14, 3)
  printMixReturnedKg Decimal @default(0) @map("print_mix_returned_kg") @db.Decimal(14, 3)
  lamMixIssuedKg     Decimal @default(0) @map("lam_mix_issued_kg") @db.Decimal(14, 3)
  lamMixReturnedKg   Decimal @default(0) @map("lam_mix_returned_kg") @db.Decimal(14, 3)

  // ---- Time on the floor ---------------------------------------------------
  makeReadyDays  Decimal @default(0) @map("make_ready_days") @db.Decimal(8, 3)
  /// What the wage bill, the EMI and the electricity are all charged against.
  productionDays Decimal @default(0) @map("production_days") @db.Decimal(8, 3)

  // ---- Output --------------------------------------------------------------
  printedGrossKg  Decimal @default(0) @map("printed_gross_kg") @db.Decimal(14, 3)
  printedCoreKg   Decimal @default(0) @map("printed_core_kg") @db.Decimal(14, 3)
  producedGrossKg Decimal @default(0) @map("produced_gross_kg") @db.Decimal(14, 3)
  producedCoreKg  Decimal @default(0) @map("produced_core_kg") @db.Decimal(14, 3)

  /**
   * What was finally packed — the figure the whole cost is divided by.
   * Typed rather than derived. The works' own sheets run it at 96% of what came
   * off the laminator on some jobs and 97% on others, because it is a weighed
   * fact and not a yield assumption. The app offers the yield as a starting
   * figure and then keeps whatever the office weighed.
   */
  finalOutputKg    Decimal @default(0) @map("final_output_kg") @db.Decimal(14, 3)
  /// Zero on a roll job, which is what makes it a roll job.
  pouchingWeightKg Decimal @default(0) @map("pouching_weight_kg") @db.Decimal(14, 3)

  // ---- The overhead rates, as they stood the day this ran ------------------
  electricityPerDay      Decimal @default(0) @map("electricity_per_day") @db.Decimal(12, 2)
  transportPerKg         Decimal @default(0) @map("transport_per_kg") @db.Decimal(10, 4)
  pouchingPerKg          Decimal @default(0) @map("pouching_per_kg") @db.Decimal(10, 4)
  packagingCost          Decimal @default(0) @map("packaging_cost") @db.Decimal(12, 2)
  emiPerDay              Decimal @default(0) @map("emi_per_day") @db.Decimal(12, 2)
  /// Taken on the material alone, which is the works' own rule. See the costing.
  profitPercent          Decimal @default(0) @map("profit_percent") @db.Decimal(6, 3)
  expectedWastagePercent Decimal @default(5) @map("expected_wastage_percent") @db.Decimal(6, 3)

  /**
   * Overheads the office settled by hand.
   * Null means the model's figure stands. Every one of the works' fourteen tabs
   * types over at least one of these, and two of them type over the electricity
   * outright — the office knows things the model does not, and a system that
   * cannot be corrected gets corrected in a spreadsheet nobody can see.
   */
  electricityOverride Decimal? @map("electricity_override") @db.Decimal(12, 2)
  salaryOverride      Decimal? @map("salary_override") @db.Decimal(12, 2)
  transportOverride   Decimal? @map("transport_override") @db.Decimal(12, 2)
  pouchingOverride    Decimal? @map("pouching_override") @db.Decimal(12, 2)
  emiOverride         Decimal? @map("emi_override") @db.Decimal(12, 2)
  profitOverride      Decimal? @map("profit_override") @db.Decimal(12, 2)

  // ---- What it came to, stored so a sheet reads without recomputing --------
  materialKg      Decimal @default(0) @map("material_kg") @db.Decimal(14, 3)
  materialCost    Decimal @default(0) @map("material_cost") @db.Decimal(14, 2)
  basicValuePerKg Decimal @default(0) @map("basic_value_per_kg") @db.Decimal(12, 2)

  electricityCost Decimal @default(0) @map("electricity_cost") @db.Decimal(12, 2)
  salaryCost      Decimal @default(0) @map("salary_cost") @db.Decimal(12, 2)
  transportCost   Decimal @default(0) @map("transport_cost") @db.Decimal(12, 2)
  pouchingCost    Decimal @default(0) @map("pouching_cost") @db.Decimal(12, 2)
  emiCost         Decimal @default(0) @map("emi_cost") @db.Decimal(12, 2)
  profit          Decimal @default(0) @db.Decimal(12, 2)
  overheadCost    Decimal @default(0) @map("overhead_cost") @db.Decimal(14, 2)

  effectivePrice Decimal @default(0) @map("effective_price") @db.Decimal(14, 2)
  /// The answer the sheet exists to produce.
  costPerKg      Decimal @default(0) @map("cost_per_kg") @db.Decimal(12, 2)

  expectedWastageKg Decimal @default(0) @map("expected_wastage_kg") @db.Decimal(14, 3)
  actualWastageKg   Decimal @default(0) @map("actual_wastage_kg") @db.Decimal(14, 3)
  wastagePercent    Decimal @default(0) @map("wastage_percent") @db.Decimal(8, 3)
  /// What the wastage over the allowance cost, at this job's own rate.
  excessCost        Decimal @default(0) @map("excess_cost") @db.Decimal(14, 2)

  /**
   * When this sheet's consumption was taken off stock.
   * Set once and never cleared. Posting writes real movements against real
   * batches, and un-posting would mean reversing them — so a sheet that has
   * been posted is closed to editing rather than quietly re-postable.
   */
  stockPostedAt DateTime? @map("stock_posted_at")

  notes     String @default("")
  enteredBy String @default("") @map("entered_by")

  lines  JobSheetLine[]
  labour JobSheetLabour[]
  stages JobSheetStageUsage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([status, date])
  @@index([jobId])
  @@index([customerId])
  @@map("job_sheets")
}

/// One consumable on one sheet: what went out, what came back, what it cost.
model JobSheetLine {
  id String @id @default(cuid())

  sheetId String   @map("sheet_id")
  sheet   JobSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  position Int
  section  JobSheetSection
  kind     JobSheetLineKind @default(OTHER)

  /// The catalogue row this is priced from. Nullable because a sheet outlives a
  /// material that is later retired, and the name and rate are snapshotted.
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name       String

  issuedKg   Decimal @default(0) @map("issued_kg") @db.Decimal(14, 3)
  returnedKg Decimal @default(0) @map("returned_kg") @db.Decimal(14, 3)

  /**
   * The mixed drum this line draws a share of, and how much of it is this.
   * An ink carries its own mix here; a solvent carries the sheet's pooled
   * total. Both are stored on the line so the arithmetic that produced the
   * consumption can be read back off the row without recomputing the sheet.
   */
  mixIssuedKg     Decimal @default(0) @map("mix_issued_kg") @db.Decimal(14, 3)
  mixReturnedKg   Decimal @default(0) @map("mix_returned_kg") @db.Decimal(14, 3)
  mixSharePercent Decimal @default(0) @map("mix_share_percent") @db.Decimal(6, 3)

  /// What the issue and return figures work out to.
  computedKg         Decimal  @default(0) @map("computed_kg") @db.Decimal(14, 3)
  /**
   * What the office typed instead, when the computed figure was wrong.
   * Two of the works' fourteen tabs carry one of these — White ink at 14.5
   * where the arithmetic said 23.52, worth Rs 2,164.80 on a Rs 65,000 job. The
   * computed figure is kept beside it so the correction is visible on the page
   * rather than lost behind the number that replaced it.
   */
  consumedOverrideKg Decimal? @map("consumed_override_kg") @db.Decimal(14, 3)
  /// The override where there is one, the computed figure where there is not.
  consumedKg         Decimal  @default(0) @map("consumed_kg") @db.Decimal(14, 3)

  /// Rupees a kilogram, as at the day of the run.
  ratePerKg Decimal @default(0) @map("rate_per_kg") @db.Decimal(12, 4)
  amount    Decimal @default(0) @db.Decimal(14, 2)

  @@unique([sheetId, position])
  @@index([materialId])
  @@map("job_sheet_lines")
}

/// One role's wages for the run.
model JobSheetLabour {
  id String @id @default(cuid())

  sheetId String   @map("sheet_id")
  sheet   JobSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  position Int
  role     String

  headcount  Decimal @default(0) @db.Decimal(8, 2)
  ratePerDay Decimal @default(0) @map("rate_per_day") @db.Decimal(10, 2)
  /// Usually the run's production days, but a role can be part of it.
  days       Decimal @default(0) @db.Decimal(8, 3)
  amount     Decimal @default(0) @db.Decimal(12, 2)

  @@unique([sheetId, position])
  @@map("job_sheet_labour")
}

/// One process's share of the day's electricity.
///
/// The shares divide ONE day's bill between the machines, so they add up to
/// 100. The works' spreadsheet splits it 60 / 20 / 20 / 10 / 10, which comes to
/// 120 and charges a job for electricity nobody bought; the works confirmed the
/// total should be 100, and the defaults are that same weighting rescaled.
///
/// Stored per sheet rather than read from settings, so a sheet costed under the
/// old split still reads as it was costed. What keeps the bill honest beyond
/// the shares is `days`: a stage that did not run is zero days and costs
/// nothing.
model JobSheetStageUsage {
  id String @id @default(cuid())

  sheetId String   @map("sheet_id")
  sheet   JobSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  stage JobSheetStage

  sharePercent Decimal @default(0) @map("share_percent") @db.Decimal(6, 3)
  days         Decimal @default(0) @db.Decimal(8, 3)
  /// Pouching routinely runs two, and the meter runs with it.
  shifts       Decimal @default(1) @db.Decimal(6, 2)
  amount       Decimal @default(0) @db.Decimal(12, 2)

  @@unique([sheetId, stage])
  @@map("job_sheet_stage_usage")
}

/// Where a delivery note has got to.
///
/// A draft is not a delivery: nothing it says counts against any order until it
/// is dispatched. See `canMoveDispatchTo` for why a dispatched note can still
/// be cancelled.
enum DispatchStatus {
  DRAFT
  DISPATCHED
  CANCELLED
}

/// **What left the building, and on whose lorry.**
///
/// The link that was missing, and the reason completing a job card never
/// completed the order: for a customer, complete means delivered, and nothing
/// knew about delivery. This does.
///
/// **One note is one lorry, not one order.** A vehicle taking three jobs to one
/// customer is one delivery, one consignment note and one signature, with a
/// line per order aboard. One note per order would mean typing the same lorry
/// number three times and handing over three challans for one drop.
///
/// One note is also **one customer**, because each customer signs for their
/// own goods.
model Dispatch {
  id     String         @id @default(cuid())
  /// Sequential and human-facing. Its own series, like an order's.
  number Int            @unique
  status DispatchStatus @default(DRAFT)

  customerId   String?   @map("customer_id")
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Snapshot, so an old challan still reads if the customer is renamed.
  customerName String    @map("customer_name")

  dispatchDate    DateTime @map("dispatch_date") @db.Date
  /// Snapshotted from the customer at the time. An address that moves must not
  /// rewrite where last year's lorries went.
  deliveryAddress String   @default("") @map("delivery_address")

  /// The lorry. Asked for when the note is sent rather than when it is drafted,
  /// because the vehicle usually turns up after the paperwork is written.
  vehicleNumber String @default("") @map("vehicle_number")
  transporter   String @default("")
  driverName    String @default("") @map("driver_name")
  driverPhone   String @default("") @map("driver_phone")
  /// The transporter's own consignment note number.
  lrNumber      String @default("") @map("lr_number")

  notes String @default("")

  lines DispatchLine[]

  raisedBy     String    @default("") @map("raised_by")
  dispatchedAt DateTime? @map("dispatched_at")
  dispatchedBy String    @default("") @map("dispatched_by")

  cancelledAt     DateTime? @map("cancelled_at")
  /// Why it did not go, or why it came back. A cancelled delivery with no
  /// reason is one nobody can account for to the customer.
  cancelledReason String    @default("") @map("cancelled_reason")

  /// Why it went out with more than the works had recorded making.
  ///
  /// Sending more than was produced is physically impossible, so the check that
  /// refuses it is right — but it is wrong often enough to matter: a run that
  /// made 512 kg against a 500 kg card has not said so until its job sheet is
  /// costed, and the lorry does not wait for the office. So the block is real,
  /// and getting past it is deliberate, named and dated.
  overrideReason String    @default("") @map("override_reason")
  overrideBy     String    @default("") @map("override_by")
  overrideAt     DateTime? @map("override_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([customerId])
  @@index([dispatchDate])
  @@map("dispatches")
}

/// One order being delivered on one note.
///
/// `quantityKg` is the line's weight, but it is not necessarily the figure the
/// office typed: where the line lists its reels, it is their sum and is written
/// from them. See `lineNetKg` — a challan with a total that disagrees with its
/// own rows is one the customer and the works read differently.
model DispatchLine {
  id         String   @id @default(cuid())
  dispatchId String   @map("dispatch_id")
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  /// 1..n, as printed down the challan.
  position   Int

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Snapshot, so an old challan still names the job it carried.
  jobName String @map("job_name")

  /// Which run the godown took it out of, where it knows. Null when the goods
  /// on the lorry came off more than one run and nobody separated them.
  productionOrderId String?          @map("production_order_id")
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  quantityKg      Decimal @map("quantity_kg") @db.Decimal(12, 3)
  quantityPouches Int     @default(0) @map("quantity_pouches")

  remarks String @default("")

  packages DispatchPackage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dispatchId, position])
  @@index([orderId])
  @@index([productionOrderId])
  @@map("dispatch_lines")
}

/// One reel, carton or bag on the lorry.
///
/// The works writes a weight on every reel it packs. Listing them is what lets
/// a customer who weighs the load back be told *which* reel is light, instead
/// of being told only that the total disagrees.
model DispatchPackage {
  id       String       @id @default(cuid())
  lineId   String       @map("line_id")
  line     DispatchLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  position Int

  /// What is written on the reel. Blank where nothing was — a weight with no
  /// number is still worth more than no row at all.
  reelNumber String @default("") @map("reel_number")

  netKg   Decimal  @map("net_kg") @db.Decimal(12, 3)
  /// With the core and the wrap. Null where the works only weighed net.
  grossKg Decimal? @map("gross_kg") @db.Decimal(12, 3)
  /// The width it was slit to, where it is known.
  widthMm Int?     @map("width_mm")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([lineId, position])
  @@map("dispatch_packages")
}

/// What the floor said, and why it stopped.
///
/// Only the things the machine screen can say that nothing else records. A
/// stage already carries when it started and finished and what it weighed;
/// what it could never say was **why a machine is standing idle** — and that
/// is the question the office asks across the floor twenty times a day.
/// Why a machine stopped.
///
/// Only two, since Quality & Waste exists: a stoppage is a moment, and a
/// defect is a state that somebody has to close. The operator's Problem
/// button raises a **QualityIssue** rather than logging a third kind here —
/// one record, with a severity and a life, instead of a line of text nobody
/// can act on.
enum FloorEventKind {
  PAUSED
  RESUMED
}

/// One thing the operator said at the machine.
///
/// Deliberately a log rather than fields on the card. A card holds one status
/// and one reason; a shift holds four stoppages, and the fourth overwriting
/// the third is how a works ends up unable to say where its day went.
///
/// This is also where Quality & Waste will read from when it is built. It is
/// not that module — there is no severity here and no categories, because
/// inventing a vocabulary the works has not asked for is how a screen ends up
/// with a dropdown nobody uses honestly.
model FloorEvent {
  id String @id @default(cuid())

  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  /// The stage it happened on. Null where the card was stopped between them.
  stageId String?          @map("stage_id")
  stage   ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  kind FloorEventKind
  /// What they said. A pause with no reason teaches nothing, so the screen
  /// insists on one.
  note String         @default("")

  /// Who said it, picked from the Employees list at the machine.
  operatorId  String?   @map("operator_id")
  operatorRef Employee? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  /// Snapshotted, so an old stoppage still names somebody after they leave.
  operator    String    @default("")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productionOrderId])
  @@index([stageId])
  @@index([createdAt])
  @@map("floor_events")
}

/// How badly it matters. The works' own three, as the floor already speaks.
enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

/// Where an issue has got to.
///
/// Three, and the middle one earns its place: "somebody is looking at it" is a
/// different thing from "nobody has picked it up", and an issues list where
/// both read as Open is a list the works stops believing.
enum IssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

/// **Something found wrong with a run.**
///
/// Raised from the machine when the operator presses Problem, or from the
/// office when it is found afterwards at the checking table. Either way it is
/// a state rather than an event: it has a severity, somebody answerable for
/// it, and it stays on the list until it is closed with a note saying what
/// happened.
///
/// `rejectedKg` is the part that reaches the rest of the system. Waste is
/// material lost **at the machine** and every stage already records it; a
/// rejection is finished film that was made, weighed and then failed — so it
/// is counted out of what the godown can send, and Dispatch stops offering
/// it. The two are separate figures because they are separate events, and
/// adding them together would be counting one loss twice.
model QualityIssue {
  id     String @id @default(cuid())
  /// Sequential and human-facing. Its own series, like an order's.
  number Int    @unique

  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  /// The stage it was found at. Null when it was found off the machine —
  /// at the checking table, or by the customer.
  stageId String?          @map("stage_id")
  stage   ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  severity IssueSeverity @default(MEDIUM)
  status   IssueStatus   @default(OPEN)

  /// One line, in the works' own words: "Delamination on the edge".
  title  String
  detail String @default("")

  /// Finished goods that cannot be sent. Not waste — see the note above.
  rejectedKg Decimal @default(0) @map("rejected_kg") @db.Decimal(12, 3)

  /// Who found it. A name rather than a link, because it may be an operator
  /// at the machine or somebody in the office, and those are different tables.
  raisedBy String @default("") @map("raised_by")

  /// Who is answerable for it. An issue nobody owns is one nobody closes.
  responsibleId   String?   @map("responsible_id")
  responsible     Employee? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  /// Snapshotted, so an old issue still names somebody after they leave.
  responsibleName String    @default("") @map("responsible_name")

  resolvedBy String    @default("") @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  /// What was actually done. "Resolved" on its own teaches nobody anything.
  resolution String    @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@index([productionOrderId])
  @@index([createdAt])
  @@map("quality_issues")
}
