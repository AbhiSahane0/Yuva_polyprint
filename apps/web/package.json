{
  "name": "@yuva/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yuva Polyprint ERP — web client",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
